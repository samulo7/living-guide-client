<template>
  <view class="card">
    <image class="avatar" :src="activity.user.avatar" mode="aspectFill"></image>

    <view class="content">
      <view class="top-row">
        <text class="nickname">{{ activity.user.nickname }}</text>
        <view class="distance-tag">
          <text class="distance-text">📍{{ activity.distance }}</text>
        </view>
      </view>

      <text class="title">{{ activity.title }}</text>

      <view class="tag-row">
        <view v-for="(tag, index) in activity.user.tags.slice(0, 3)" :key="index" class="pill">
          <text class="pill-text">{{ tag }}</text>
        </view>
      </view>

      <text class="meta">{{ activity.time_ago }} · {{ joinedText }}</text>
    </view>

    <view class="action-wrap">
      <view class="join-btn" :class="{ disabled: activity.status === 'full' }" @click.stop="emit('join')">
        <text class="join-text">{{ activity.status === 'full' ? '已满' : '加入' }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { computed } from 'vue'
import type { ActivityItem } from '../types/social'

interface Props {
  activity: ActivityItem
}

const props = defineProps<Props>()
const emit = defineEmits<{ join: [] }>()

const joinedText = computed(() => `${props.activity.joined_people}/${props.activity.max_people} 人`)
</script>

