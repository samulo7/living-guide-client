<template>
  <view class="job-card" hover-class="job-card-active" @click="emit('click')">
    <view class="card-main">
      <view class="left">
        <text class="title">{{ data.title }}</text>
        <view class="tags-row">
          <view class="tag" v-for="(tag, index) in data.tags" :key="index">
            <text class="tag-text">{{ tag }}</text>
          </view>
          <view class="tag settlement-tag">
            <text class="settlement-text">{{ data.settlement }}</text>
          </view>
        </view>
      </view>

      <view class="right">
        <text class="salary">{{ salaryText }}</text>
      </view>
    </view>

    <view class="survival-row">
      <text class="fire">🔥</text>
      <text class="survival-text">此收入约覆盖{{ cityName }} {{ safeCoverage }}% 生活费</text>
    </view>
  </view>
</template>

<script setup lang="ts">
import { computed } from 'vue'
import type { JobItem } from '../types/job'
import { formatSalary } from '../utils/useJobs'

interface Props {
  data: JobItem
  cityName: string
  coveragePercent: number
}

const props = defineProps<Props>()
const emit = defineEmits<{ click: [] }>()

const salaryText = computed((): string => formatSalary(props.data))
const safeCoverage = computed((): string => Math.max(0, props.coveragePercent).toFixed(0))
</script>

