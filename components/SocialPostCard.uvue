}

.danger-btn {
  height: 28px;
  border-radius: 14px;
  justify-content: center;
  align-items: center;
  background-color: transparent;
  border: 1px solid #fecaca;
  padding: 0 12px;
  margin-right: 8px;
}

.danger-btn-text {
  color: #b91c1c;
  font-size: 12px;
