  line-height: 20px;
  color: #475569;
}

.location-line {
  margin-top: 8px;
  font-size: 12px;
  color: #556273;
}

.cover-wrap {
  margin-top: 10px;
  position: relative;
}

.card-cover {
  width: 100%;
  height: 168px;
  border-radius: 12px;
}

.done-badge {
  position: absolute;
  right: 10px;
  top: 10px;
  font-size: 11px;
  color: #14532d;
  font-weight: 700;
  background-color: rgba(220, 252, 231, 0.94);
  border: 1px solid #86efac;
  border-radius: 999px;
  padding: 4px 10px;
}

.tag-row {
  margin-top: 12px;
  flex-direction: row;
  flex-wrap: wrap;
}

.tag-chip {
