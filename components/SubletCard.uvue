<template>
  <view class="card" hover-class="card-active" @click="emit('click')">
    <view class="cover-wrap">
      <image class="cover" :src="data.cover_image" mode="aspectFill"></image>
      <view v-if="data.is_verified" class="verified">
        <text class="verified-text">✅ 实探/房东直签</text>
      </view>
    </view>

    <view class="content">
      <view class="price-row">
        <text class="price">¥{{ data.price }}</text>
        <text class="unit">/{{ shortUnit }}</text>
      </view>
      <text class="duration">{{ data.min_duration }}</text>
      <text class="title">{{ data.title }}</text>

      <view class="tags-row">
        <view v-for="(tag, index) in data.tags.slice(0, 3)" :key="index" class="tag">
          <text class="tag-text">{{ tag }}</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { computed } from 'vue'
import type { SubletItem } from '../types/sublet'

interface Props {
  data: SubletItem
}

const props = defineProps<Props>()
const emit = defineEmits<{ click: [] }>()

const shortUnit = computed(() => props.data.price_unit.replace('元/', '').replace('元', ''))
</script>

