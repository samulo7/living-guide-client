<template>
  <view class="row">
    <view class="title-row">
      <text class="city">在{{ cityName }}：</text>
      <text class="desc">可躺平 {{ safeMonths }} 个月</text>
    </view>
    <text class="cost">月生活费约 ¥{{ safeCost }}</text>

    <view class="bar-bg">
      <view class="bar-fill" :class="barClass" :style="{ width: widthText }"></view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { computed } from 'vue'

interface Props {
  cityName: string
  months: number
  livingCost: number
  coveragePercent: number
}

const props = defineProps<Props>()

const safeMonths = computed((): string => Math.max(0, props.months).toFixed(1))
const safeCost = computed((): string => Math.max(0, props.livingCost).toFixed(0))
const widthText = computed((): string => `${Math.min(100, Math.max(0, props.coveragePercent))}%`)

const barClass = computed((): string => {
  if (props.months >= 2) {
    return 'green'
  }
  if (props.months >= 1) {
    return 'yellow'
  }
  return 'red'
})
</script>

<style scoped>
.row {
  margin-bottom: 16px;
}

.title-row {
  flex-direction: row;
  align-items: baseline;
  margin-bottom: 4px;
}

.city {
  font-size: 14px;
  color: #595959;
}

.desc {
  font-size: 15px;
  font-weight: 800;
  color: #262626;
}

.cost {
  font-size: 12px;
  color: #8c8c8c;
  margin-bottom: 8px;
}

.bar-bg {
  width: 100%;
  height: 10px;
  background-color: #f0f0f0;
  border-radius: 5px;
  overflow: hidden;
}

.bar-fill {
  height: 10px;
  border-radius: 5px;
}

.green {
  background-color: #52c41a;
}

.yellow {
  background-color: #faad14;
}

.red {
  background-color: #ff4d4f;
}
</style>
