<template>
  <view class="page-container">
    <view class="nav-placeholder"></view>

    <scroll-view class="scroll-content" direction="vertical">
      <view class="hero-section">
        <image 
          class="hero-image" 
          :src="coverUrl" 
          mode="aspectFill"
          @error="onImageError"
        ></image>
        
        <view class="hero-overlay">
          <text class="hero-city">{{ heroTitle }}</text>
          <text class="hero-district">{{ heroSubtitle }}</text>
        </view>
        <view class="back-btn" @click="goBack">
          <text class="back-arrow">←</text>
        </view>
      </view>

      <view class="dashboard-card">
        <view class="dashboard-header">
          <text class="section-title">生活成本 & 配套</text>
          <text class="update-time">👉 更新于 {{ updateDate }}</text>
        </view>
        
        <view class="stats-grid">
          <view class="stat-item">
            <text class="stat-label">月租金</text>
            <text class="stat-value price" v-if="rentPriceDisplay">{{ rentPriceDisplay }}</text>
          </view>
          <view class="stat-item">
            <text class="stat-label">买房</text>
            <text class="stat-value">{{ cityItem.price_buy || '暂无' }}</text>
          </view>
          <view class="stat-item">
            <text class="stat-label">交通</text>
            <text class="stat-value" v-if="transportText">{{ transportText }}</text>
          </view>
        </view>

        <view class="map-btn-wrap" v-if="hasLocation" @click="openMap">
          <text class="map-btn-text">📍 查看地图位置</text>
          <text class="map-arrow">></text>
        </view>
      </view>

      <view class="content-section">
        
        
        <view class="medical-card" :class="medicalInfo['bgClass']">
          <view class="medical-header">
            <text class="medical-icon">{{ medicalInfo['icon'] }}</text>
            <text class="medical-title">医疗环境评估</text>
          </view>
          <text class="medical-desc" v-if="medicalInfo['desc']">{{ medicalInfo['desc'] }}</text>
          <view class="medical-divider" v-if="medicalText || suitableCrowdText"></view>
          <text class="medical-raw" v-if="medicalText">医疗条件：{{ medicalText }}</text>
          <text class="medical-tips" v-if="suitableCrowdText">适宜人群：{{ suitableCrowdText }}</text>
        </view>

        <view class="guru-card" v-if="guruQuote">
          <view class="block-header">
            <text class="block-icon">📝</text> 
            <text class="block-title">小编点评</text>
          </view>
          <text class="block-text">{{ guruQuote }}</text>
        </view>

        <view class="content-block climate-block" v-if="climateTokens.length > 0">
          <view class="block-header">
            <text class="block-icon">🌤️</text>
            <text class="block-title">气候体感</text>
          </view>
          <view class="climate-tags">
            <text class="climate-tag" v-for="(item, index) in climateTokens" :key="index">{{ item }}</text>
          </view>
        </view>

        <view class="content-block cons-block" v-if="consInfo">
          <view class="block-header">
            <text class="block-icon">⚠️</text>
            <text class="block-title warning-text">注意/避坑</text>
          </view>
          <text class="block-text">{{ consInfo }}</text>
        </view>

        <view class="sublet-block">
          <view class="sublet-head">
            <text class="sublet-title">本市房源推荐</text>
            <text class="sublet-more" @click="goToCitySublets">查看全部 ></text>
          </view>
          <view v-if="recommendedSublets.length === 0" class="sublet-empty">
            <text class="sublet-empty-text">本市暂未收录房源，可先去安家页看看其他城市</text>
          </view>
          <view v-else>
            <view
              class="sublet-item"
              v-for="room in recommendedSublets"
              :key="room.id"
              @click="goToRoomDetail(room.id)"
            >
              <image class="sublet-cover" :src="room.cover_image" mode="aspectFill"></image>
              <view class="sublet-content">
                <text class="sublet-item-title">{{ room.title }}</text>
                <text class="sublet-item-meta">{{ room.district }} · {{ room.community }}</text>
                <text class="sublet-item-price">¥{{ room.price }}/月 · {{ room.min_duration }}</text>
              </view>
            </view>
          </view>
        </view>
        
        <view style="height: 100px;"></view>
      </view>
    </scroll-view>

    <view class="footer-bar">
      <view class="action-btn btn-secondary" hover-class="btn-pressed" @click="openFeedbackModal">
        <text class="btn-text text-secondary">我要纠错</text>
      </view>
      <view class="action-btn btn-primary" hover-class="btn-pressed">
        <text class="btn-text text-primary">收藏城市</text>
      </view>
    </view>

    <view class="modal-mask" v-if="showModal" @click="closeModal">
      <view class="modal-content" @click.stop>
        <view class="modal-header">
          <text class="modal-title">补充城市信息</text>
          <text class="close-icon" @click="closeModal">✕</text>
        </view>
        <scroll-view class="modal-body" direction="vertical">
          <text class="form-label">纠错类型</text>
          <view class="tags-container">
            <view class="form-tag" :class="{ 'tag-active': feedbackType === 'price' }" @click="feedbackType = 'price'">
              <text class="form-tag-text" :class="{ 'text-active': feedbackType === 'price' }">数据过期</text>
            </view>
            <view class="form-tag" :class="{ 'tag-active': feedbackType === 'pitfall' }" @click="feedbackType = 'pitfall'">
              <text class="form-tag-text" :class="{ 'text-active': feedbackType === 'pitfall' }">🔥 补充槽点</text>
            </view>
            <view class="form-tag" :class="{ 'tag-active': feedbackType === 'other' }" @click="feedbackType = 'other'">
              <text class="form-tag-text" :class="{ 'text-active': feedbackType === 'other' }">其他</text>
            </view>
          </view>
          <text class="form-label">详细描述</text>
          <textarea class="form-textarea" :placeholder="placeholderText" v-model="feedbackContent" :maxlength="200"></textarea>
          <text class="form-label">上传凭证 (选填)</text>
          <view class="upload-box">
            <text class="upload-icon">📷</text>
            <text class="upload-text">点击上传图片</text>
          </view>
        </scroll-view>
        <view class="modal-footer">
          <view class="submit-btn" hover-class="btn-pressed" @click="submitFeedback">
            <text class="submit-text">提交审核</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed } from 'vue'
import type { CityItem } from '../../types/city'
import { buildApiUrl } from '../../utils/api'

interface CityDetailResponse {
  ok: boolean
  data?: CityItem
  message?: string
}

interface CityHousesResponse {
  ok: boolean
  data?: Record<string, unknown>[]
  message?: string
}

interface CityHouseItem {
  id: string
  cover_image: string
  title: string
  district: string
  community: string
  price: number
  min_duration: string
}

const emptyItem = {
  id: '', city: '', district: '', title: '',
  name: '', location_text: '',
  price_rent: 0, price_buy: '', tags: [] as string[],
  medical: '', transport: '', landscape: '',
  suitable_crowd: '', editor_comment: '',
  cover_image: '', is_verified: false,
  detail: { guru_comment: '', climate_info: '', cons: '', medical_desc: '', transport_desc: '' },
  radar_data: { cost: 0, medical: 0, transport: 0, climate: 0, fun: 0 },
  location: { lat: 0, lng: 0 },
  has_hospital_class_a: false
} as CityItem

const cityItem = ref<CityItem>(emptyItem)
const recommendedSublets = ref<CityHouseItem[]>([])
const updateDate = ref('--')
const imgLoadError = ref(false)

function parseApiPayload<T>(raw: unknown): T | null {
  if (raw != null && typeof raw == 'object') {
    return raw as T
  }
  if (typeof raw == 'string') {
    const text = raw.trim()
    if (text == '') {
      return null
    }
    try {
      return JSON.parse<T>(text)
    } catch (error) {
      return null
    }
  }
  return null
}

function formatUpdateDate(): string {
  const now = new Date()
  const month = String(now.getMonth() + 1).padStart(2, '0')
  return String(now.getFullYear()) + '.' + month
}

async function fetchCityDetail(id: string): Promise<CityItem> {
  return new Promise<CityItem>((resolve, reject) => {
    uni.request({
      url: buildApiUrl('/api/cities/' + encodeURIComponent(id)),
      method: 'GET',
      success: (res) => {
        if (res.statusCode != 200) {
          reject('request failed: ' + res.statusCode)
          return
        }
        const payload = parseApiPayload<CityDetailResponse>(res.data)
        if (payload == null || payload.ok != true || payload.data == null) {
          reject(payload?.message ?? 'city detail is empty')
          return
        }
        resolve(payload.data)
      },
      fail: (error) => reject(error)
    })
  })
}

function mapCityHouseRow(row: Record<string, unknown>): CityHouseItem {
  return {
    id: String(row.id ?? ''),
    cover_image: String(row.cover_image ?? ''),
    title: String(row.title ?? ''),
    district: String(row.district ?? ''),
    community: String(row.community ?? ''),
    price: Number(row.price ?? 0),
    min_duration: String(row.min_duration ?? '')
  }
}

async function fetchCityHouses(cityId: string): Promise<CityHouseItem[]> {
  return new Promise<CityHouseItem[]>((resolve, reject) => {
    uni.request({
      url: buildApiUrl('/api/cities/' + encodeURIComponent(cityId) + '/houses'),
      method: 'GET',
      success: (res) => {
        if (res.statusCode != 200) {
          reject('request failed: ' + res.statusCode)
          return
        }
        const payload = parseApiPayload<CityHousesResponse>(res.data)
        if (payload == null || payload.ok != true || !Array.isArray(payload.data)) {
          reject(payload?.message ?? 'city houses is empty')
          return
        }
        resolve(payload.data.map((item) => mapCityHouseRow(item)))
      },
      fail: (error) => reject(error)
    })
  })
}

onLoad(async (options) => {
  const id = String(options?.id || '').trim()
  if (id == '') {
    uni.showToast({ title: 'Invalid city id', icon: 'none' })
    return
  }
  await initData(id)
})

const initData = async (id: string) => {
  try {
    const detail = await fetchCityDetail(id)
    cityItem.value = detail
    updateDate.value = formatUpdateDate()
    imgLoadError.value = false
    try {
      recommendedSublets.value = await fetchCityHouses(id)
    } catch (error) {
      console.error('[detail] load city houses failed:', error)
      recommendedSublets.value = []
    }
  } catch (error) {
    console.error('[detail] load city detail failed:', error)
    uni.showToast({ title: 'Failed to load detail', icon: 'none' })
    recommendedSublets.value = []
  }
}

const fullCityName = computed((): string => {
  const rawName = String(cityItem.value.name || '').trim()
  if (rawName != '') {
    return rawName
  }
  return String(cityItem.value.city || '').trim()
})

const heroTitle = computed((): string => {
  const text = fullCityName.value
  if (text == '') {
    return 'Loading...'
  }
  const parts = text.split('/')
  return parts[0]?.trim() || text
})

const heroSubtitle = computed((): string => {
  const text = fullCityName.value
  const parts = text.split('/')
  if (parts.length > 1) {
    const sub = parts.slice(1).join('/').trim()
    if (sub != '') {
      return sub
    }
  }
  const locationText = String(cityItem.value.location_text || '').trim()
  if (locationText != '') {
    return locationText
  }
  return String(cityItem.value.district || '').trim()
})

function sanitizeText(value: unknown): string {
  const text = String(value ?? '').trim()
  if (text == '') {
    return ''
  }
  const lower = text.toLowerCase()
  if (lower == 'n/a' || lower == 'null' || lower == 'undefined') {
    return ''
  }
  return text
}
function splitTokens(value: string): string[] {
  return value
    .split(/[\/\s、,，|·]+/)
    .map((item) => sanitizeText(item))
    .filter((item) => item != '')
}
const rentPriceDisplay = computed((): string => {
  const value = Number(cityItem.value.price_rent || 0)
  if (!Number.isFinite(value) || value <= 0) {
    return ''
  }
  return '¥' + value
})
const transportText = computed((): string => sanitizeText(cityItem.value.transport))
const medicalText = computed((): string => sanitizeText(cityItem.value.medical))
const suitableCrowdText = computed((): string => sanitizeText(cityItem.value.suitable_crowd))
const coverUrl = computed((): string => {
  let idNum = 1
  try {
    const parsed = Number.parseInt(String(cityItem.value.id || '1'), 10)
    if (!Number.isNaN(parsed)) {
      idNum = parsed
    }
  } catch (error) {
    idNum = 1
  }

  const fallbackUrl = '/static/images/' + ((idNum % 4) + 1) + '.jpg'
  if (imgLoadError.value) {
    return fallbackUrl
  }
  if (cityItem.value.cover_image && cityItem.value.cover_image.trim() != '') {
    return cityItem.value.cover_image
  }
  return fallbackUrl
})

const onImageError = () => {
  imgLoadError.value = true
}

const hasLocation = computed((): boolean => {
  const loc = cityItem.value.location
  return loc.lat != 0 && loc.lng != 0
})

const openMap = () => {
  const loc = cityItem.value.location
  const name = heroTitle.value + heroSubtitle.value
  const url = 'https://uri.amap.com/marker?position=' + loc.lng + ',' + loc.lat + '&name=' + name + '&coordinate=gaode&callnative=1'
  uni.navigateTo({ url: '/pages/webview/webview?url=' + encodeURIComponent(url) })
}

const goToCitySublets = () => {
  const city = String(cityItem.value.city || '').trim()
  uni.navigateTo({ url: '/pages/sublet/index?city=' + encodeURIComponent(city) })
}

const goToRoomDetail = (id: string) => {
  uni.navigateTo({ url: '/pages/sublet/detail?id=' + id })
}

const guruQuote = computed((): string => {
  const editorComment = String(cityItem.value.editor_comment || '').trim()
  if (editorComment != '') {
    return editorComment
  }
  return String(cityItem.value.detail?.guru_comment || '').trim()
})

const climateTokens = computed((): string[] => {
  const sourceTexts: string[] = []

  const landscape = sanitizeText(cityItem.value.landscape)
  if (landscape != '') {
    sourceTexts.push(landscape)
  }

  const tags = Array.isArray(cityItem.value.tags) ? cityItem.value.tags : []
  tags.forEach((tag) => {
    const cleaned = sanitizeText(tag)
    if (cleaned != '') {
      sourceTexts.push(cleaned)
    }
  })

  const seen = new Set<string>()
  const result: string[] = []
  sourceTexts.forEach((item) => {
    splitTokens(item).forEach((token) => {
      if (!seen.has(token)) {
        seen.add(token)
        result.push(token)
      }
    })
  })
  return result
})

const consInfo = computed(() => cityItem.value.detail?.cons || '')

const medicalInfo = computed(() => {
  if (!cityItem.value) {
    return { bgClass: '', icon: '', title: '', desc: '' }
  }
  if (cityItem.value.has_hospital_class_a) {
    return {
      bgClass: 'bg-green',
      icon: '\u2705',
      title: '医疗资源：完善（三甲覆盖）',
      desc: medicalText.value != '' ? `医疗条件：${medicalText.value}` : ''
    }
  }
  return {
    bgClass: 'bg-gray',
    icon: '\u26A0\uFE0F',
    title: '医疗资源：基础保障',
    desc: medicalText.value != '' ? `医疗条件：${medicalText.value}` : ''
  }
})

const goBack = () => uni.navigateBack({})

const showModal = ref(false)
const feedbackType = ref('pitfall')
const feedbackContent = ref('')

const placeholderText = computed(() => {
  if (feedbackType.value === 'pitfall') {
    return 'e.g. heating weak in winter, many mosquitos in summer, shipping expensive'
  } else if (feedbackType.value === 'price') {
    return 'e.g. current rent is around 800/month'
  }
  return 'Please describe the issue'
})

const openFeedbackModal = () => {
  showModal.value = true
  feedbackType.value = 'pitfall'
  feedbackContent.value = ''
}

const closeModal = () => {
  showModal.value = false
}

const submitFeedback = () => {
  if (feedbackContent.value.trim() === '') {
    uni.showToast({ title: 'Please enter details', icon: 'none' })
    return
  }
  uni.showLoading({ title: 'Submitting...', mask: true })
  setTimeout(() => {
    uni.hideLoading()
    console.log('[feedback] city:', cityItem.value.city)
    console.log('[feedback] type:', feedbackType.value)
    console.log('[feedback] content:', feedbackContent.value)
    showModal.value = false
    uni.showToast({ title: 'Thanks, we will review it', icon: 'success', duration: 3000 })
    feedbackContent.value = ''
    feedbackType.value = 'pitfall'
  }, 1000)
}
</script>

<style scoped>
/* --- 布局基础 --- */
.page-container { flex: 1; background-color: #f5f7fa; height: 100vh; display: flex; flex-direction: column; }
.scroll-content { flex: 1; }
.hero-section { position: relative; height: 280px; width: 100%; }
.hero-image { width: 100%; height: 100%; }
.hero-overlay { position: absolute; bottom: 0; left: 0; right: 0; padding: 30px 20px; background-image: linear-gradient(to top, rgba(0,0,0,0.7), transparent); }
.hero-city { font-size: 32px; font-weight: 900; color: #fff; }
.hero-district { font-size: 16px; color: rgba(255,255,255,0.9); margin-top: 4px; }
.back-btn { position: absolute; top: 50px; left: 20px; width: 40px; height: 40px; background-color: rgba(0,0,0,0.3); border-radius: 20px; justify-content: center; align-items: center; }
.back-arrow { color: #fff; font-size: 20px; font-weight: bold; }

/* --- 核心数据卡片 --- */
.dashboard-card { margin: -20px 16px 0; background-color: #fff; border-radius: 16px; padding: 20px; box-shadow: 0 4px 16px rgba(0,0,0,0.06); position: relative; }
.dashboard-header { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 20px; }
.section-title { font-size: 18px; font-weight: bold; color: #333; }
.update-time { font-size: 12px; color: #999; }
.stats-grid { flex-direction: row; justify-content: space-between; }
.stat-item { align-items: center; flex: 1; }
.stat-label { font-size: 12px; color: #888; margin-bottom: 6px; }
.stat-value { font-size: 15px; font-weight: bold; color: #333; }
.price { color: #ff5500; font-size: 18px; }

/* 地图按钮 */
.map-btn-wrap {
  margin-top: 20px;
  background-color: #F7F8FA; 
  border-radius: 8px;
  padding: 12px;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}
.map-btn-text { color: #5C8D89; font-size: 14px; font-weight: bold; }
.map-arrow { color: #5C8D89; font-size: 14px; margin-left: 4px; }

.content-section { padding: 20px 16px; }

/* --- 医疗卡片 --- */
.section-title-row { margin-bottom: 12px; }
.section-title-text { font-size: 18px; font-weight: bold; color: #333; }
.medical-card { margin-bottom: 20px; padding: 16px; border-radius: 12px; }
.bg-green { background-color: #F1F8E9; border: 1px solid #DCEDC8; }
.bg-gray { background-color: #FAFAFA; border: 1px solid #EEEEEE; }
.medical-header { flex-direction: row; align-items: center; margin-bottom: 8px; }
.medical-icon { font-size: 18px; margin-right: 6px; }
.medical-title { font-size: 16px; font-weight: bold; color: #333; }
.medical-desc { font-size: 14px; color: #555; line-height: 1.5; margin-bottom: 8px; }
.medical-divider { height: 1px; background-color: rgba(0,0,0,0.05); margin: 8px 0; }
.medical-raw { font-size: 12px; color: #999; margin-bottom: 8px; }
.medical-tips { font-size: 13px; color: #666; background-color: rgba(255,255,255,0.6); padding: 8px; border-radius: 6px; line-height: 1.6; }

/* --- 📝 小编点评 (独立类名，确保不被污染) --- */
.guru-card {
 background-color: #F0F4F8;  /* 柔和的蓝灰色 */
   border-radius: 12px;
   padding: 16px;
   margin-bottom: 16px;
   border: 1px solid #E0E7EE;
}

/* --- 通用内容块 (气候/其他) --- */
.content-block { 
  background-color: #fff; 
  border-radius: 12px; 
  padding: 16px; 
  margin-bottom: 16px; 
}
.block-header { flex-direction: row; align-items: center; margin-bottom: 10px; }
.block-icon { font-size: 18px; margin-right: 8px; }
.block-title { font-size: 16px; font-weight: bold; color: #333; }
.block-text { font-size: 15px; color: #555; line-height: 1.6; }

/* 气候体感 (蓝) */
.climate-block { background-color: #F0F9FF; border: 1px solid #E1F5FE; }
.climate-block .block-title, .climate-block .block-icon { color: #0288D1; }
.climate-tags { flex-direction: row; flex-wrap: wrap; }
.climate-tag {
  font-size: 12px;
  color: #0277BD;
  background-color: rgba(2, 136, 209, 0.12);
  border: 1px solid rgba(2, 136, 209, 0.22);
  border-radius: 999px;
  padding: 4px 10px;
  margin-right: 8px;
  margin-bottom: 8px;
}

/* 避坑指南 (黄) */
.cons-block { background-color: #FFFBE6; border: 1px solid #FFE58F; border-radius: 12px; padding: 16px; margin-bottom: 16px; margin-top: 24px; }
.cons-block .block-title, .cons-block .warning-text, .cons-block .block-icon { color: #D48806 !important; }
.cons-block .block-text { color: #555; }

/* 房源推荐 */
.sublet-block { background-color: #FFFDF5; border: 1px solid #F3E8C2; border-radius: 12px; padding: 14px; margin-bottom: 16px; }
.sublet-head { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 10px; }
.sublet-title { font-size: 16px; color: #5A4B27; font-weight: bold; }
.sublet-more { font-size: 12px; color: #1890FF; }
.sublet-empty { background-color: #fff; border-radius: 8px; padding: 10px; }
.sublet-empty-text { font-size: 12px; color: #8c8c8c; }
.sublet-item { background-color: #fff; border-radius: 10px; padding: 8px; margin-bottom: 10px; flex-direction: row; }
.sublet-item:last-child { margin-bottom: 0; }
.sublet-cover { width: 92px; height: 72px; border-radius: 8px; margin-right: 10px; }
.sublet-content { flex: 1; justify-content: space-between; }
.sublet-item-title { font-size: 13px; color: #262626; font-weight: 700; lines: 2; }
.sublet-item-meta { font-size: 11px; color: #8c8c8c; margin-top: 2px; }
