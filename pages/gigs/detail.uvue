<template>
  <view class="page">
    <scroll-view class="scroll" direction="vertical">
      <view class="top-bar">
        <view class="back-btn" @click="goBack">
          <text class="back-text">← 返回</text>
        </view>
      </view>

      <view class="warning-box">
        <text class="warning-text">⚠️ 警惕诈骗：凡是要求先交押金、垫付资金、刷单的都是诈骗！平台仅做信息展示。</text>
      </view>

      <view class="job-info">
        <text class="job-title">{{ job.title }}</text>
        <text class="salary">{{ salaryText }}</text>
        <view class="meta-row">
          <text class="meta">结算：{{ job.settlement }}</text>
          <text class="meta">联系人：{{ job.contact }}</text>
        </view>
        <view class="tags-row">
          <view v-for="(tag, index) in job.tags" :key="index" class="tag">
            <text class="tag-text">{{ tag }}</text>
          </view>
        </view>
      </view>

      <view class="calculator">
        <text class="section-title">生存力计算器</text>
        <text class="desc">公式：生存月数 = 职位薪资 / 城市月平均生活费</text>
        <survival-bar
          v-for="item in compareList"
          :key="item.id"
          :city-name="item.name"
          :months="item.months"
          :living-cost="item.living_cost"
          :coverage-percent="item.coverage_percent"
        />
      </view>

      <view style="height: 30px;"></view>
    </scroll-view>
  </view>
</template>

<script setup lang="ts">
import { computed, ref } from 'vue'
import { onLoad } from '@dcloudio/uni-app'
import SurvivalBar from '../../components/SurvivalBar.uvue'
import type { JobItem } from '../../types/job'
import { buildSurvivalCompare, formatSalary, loadJobs } from '../../utils/useJobs'

const defaultJob = {
  id: '',
  title: '加载中...',
  salary: 0,
  salary_unit: '元/月',
  settlement: '',
  tags: [] as string[],
  contact: '',
  survival_city_ref: 'hegang',
  is_scam_warning: false
} as JobItem

const job = ref<JobItem>(defaultJob)

const salaryText = computed(() => formatSalary(job.value))
const compareList = computed(() => buildSurvivalCompare(job.value))

const goBack = () => uni.navigateBack({})

onLoad(async (options) => {
  const id = options['id']
  if (id == null) {
    return
  }
  try {
    const jobs = await loadJobs()
    const found = jobs.find((item) => item.id == (id as string))
    if (found != null) {
      job.value = found
    }
  } catch (error) {
    uni.showToast({ title: '职位详情加载失败', icon: 'none' })
  }
})
</script>

