  margin: 0 16px 12px;
  padding: 12px;
  border-radius: 10px;
  background-color: #fff2f0;
  border: 1px solid #ffccc7;
}

.warning-text {
  color: #cf1322;
  font-size: 13px;
  line-height: 20px;
}

.job-info {
  margin: 0 16px;
  background-color: #ffffff;
  border-radius: 12px;
  padding: 14px;
}

.job-title {
  font-size: 20px;
  color: #262626;
  font-weight: 900;
}

.salary {
  margin-top: 8px;
  font-size: 24px;
  color: #fa8c16;
  font-weight: 900;
}

.meta-row {
  margin-top: 8px;
}

.meta {
  font-size: 13px;
  color: #595959;
  display: block;
  margin-top: 4px;
}

.tags-row {
  margin-top: 10px;
  flex-direction: row;
  flex-wrap: wrap;
}

.tag {
  margin-right: 8px;
  margin-bottom: 8px;
  background-color: #f5f5f5;
  border-radius: 12px;
  padding: 4px 10px;
}

.tag-text {
  font-size: 12px;
  color: #595959;
}

.calculator {
  margin: 12px 16px 0;
  background-color: #ffffff;
  border-radius: 12px;
  padding: 16px 14px;
}

