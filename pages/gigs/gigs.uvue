<template>
  <view class="page">
    <view class="hero">
      <text class="hero-title">搞钱大厅</text>
      <text class="hero-subtitle">不赚钱怎么躺平？搞点伙食费</text>
      <view class="hero-tips">
        <text class="hero-tip">兼职补贴</text>
        <text class="hero-tip">包吃住义工</text>
        <text class="hero-tip">可远程</text>
      </view>
    </view>

    <scroll-view class="list-scroll" direction="vertical">
      <view v-if="loading" class="state-wrap">
        <text class="state-text">正在加载职位...</text>
      </view>

      <view v-else-if="jobList.length == 0" class="state-wrap">
        <text class="state-text">当前暂无可投递职位</text>
      </view>

      <view v-else>
        <view class="job-card" v-for="job in jobList" :key="job.id">
          <view class="job-head">
            <text class="job-title">{{ job.title }}</text>
            <text class="job-salary">{{ salaryText(job.salary) }}</text>
          </view>

          <text class="job-company">{{ job.company != '' ? job.company : '匿名雇主' }}</text>

          <view class="meta-row">
            <text v-if="job.is_remote == 1" class="remote-badge">🌐 可远程</text>
            <text v-else class="city-text">📍 {{ cityText(job.city_name) }}</text>
          </view>

          <view class="tag-row" v-if="job.tags.length > 0">
            <text
              v-for="(tag, index) in job.tags"
              :key="job.id + '-' + index"
              :class="['tag-chip', 'tag-chip-' + String(index % 4)]"
            >
              {{ tag }}
            </text>
          </view>

          <text class="job-desc">{{ job.description }}</text>
          <view class="action-row">
            <text class="contact-btn" @click="contactBoss(job)">💬 联系老板</text>
          </view>
        </view>
      </view>

      <view style="height: 20px;"></view>
    </scroll-view>
  </view>
</template>

<script setup lang="ts">
import { ref } from 'vue'

interface JobListResponse {
  ok: boolean
  data?: Record<string, unknown>[]
  message?: string
}

interface JobItem {
  id: string
  title: string
  salary: string
  company: string
  is_remote: number
  city_name: string
  tags: string[]
  description: string
}

const API_BASE_URL = 'http://localhost:3000'

const loading = ref(true)
const jobList = ref<JobItem[]>([])

function parseApiPayload<T>(raw: unknown): T | null {
  if (raw != null && typeof raw == 'object') {
    return raw as T
  }
  if (typeof raw == 'string') {
    const text = raw.trim()
    if (text == '') {
      return null
    }
    try {
      return JSON.parse<T>(text)
    } catch (error) {
      return null
    }
  }
  return null
}

function splitTags(rawTags: unknown): string[] {
  if (Array.isArray(rawTags)) {
    return rawTags
      .map((item) => String(item || '').trim())
      .filter((item) => item != '')
  }
  const text = String(rawTags || '').trim()
  if (text == '') {
    return []
  }
  return text
    .split(/[、,，;；|/]+/)
    .map((item) => item.trim())
    .filter((item) => item != '')
}

function normalizeSalary(rawSalary: unknown): string {
  const text = String(rawSalary || '').trim()
  if (text == '') {
    return '面议'
  }
  if (text.includes('¥') || text.includes('元')) {
    return text
  }
  const amount = Number(text)
  if (Number.isFinite(amount) && amount > 0) {
    return '¥' + String(Math.round(amount))
  }
  return text
}

function mapJobRow(row: Record<string, unknown>): JobItem {
  return {
    id: String(row.id ?? ''),
    title: String(row.title ?? ''),
    salary: normalizeSalary(row.salary),
    company: String(row.company ?? '').trim(),
    is_remote: Number(row.is_remote ?? 0) == 1 ? 1 : 0,
    city_name: String(row.city_name ?? '').trim(),
    tags: splitTags(row.tags),
    description: String(row.description ?? '').trim()
  }
}

function salaryText(value: string): string {
  const text = String(value || '').trim()
  return text != '' ? text : '面议'
}

function cityText(value: string): string {
  const text = String(value || '').trim()
  return text != '' ? text : '城市待定'
}

function contactBoss(job: JobItem) {
  void job
  uni.showToast({ title: '模拟：正在为您拉起老板微信...', icon: 'none' })
}

async function fetchJobs(): Promise<JobItem[]> {
  return new Promise<JobItem[]>((resolve, reject) => {
    uni.request({
      url: API_BASE_URL + '/api/jobs',
      method: 'GET',
      success: (res) => {
        if (res.statusCode != 200) {
          reject('request failed: ' + res.statusCode)
          return
        }
        const payload = parseApiPayload<JobListResponse>(res.data)
        if (payload == null || payload.ok != true || !Array.isArray(payload.data)) {
          reject(payload?.message ?? 'jobs is empty')
          return
        }
        resolve(payload.data.map((item) => mapJobRow(item)))
      },
      fail: (error) => reject(error)
    })
  })
}

onLoad(async () => {
  loading.value = true
  try {
    jobList.value = await fetchJobs()
  } catch (error) {
    console.error('[gigs] load jobs failed:', error)
    jobList.value = []
    uni.showToast({ title: '加载职位失败', icon: 'none' })
  } finally {
    loading.value = false
  }
})
</script>

