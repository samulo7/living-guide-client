  height: 100vh;
  background-color: #ffffff;
  justify-content: center;
  align-items: center;
  padding: 0 24px;
}

.center-wrap {
  width: 100%;
  max-width: 420px;
  align-items: center;
}

.brand-block {
  align-items: center;
  margin-bottom: 28px;
}

.brand-logo {
  font-size: 50px;
  line-height: 58px;
}

.brand-title {
  margin-top: 10px;
  font-size: 34px;
  color: #0f172a;
  font-weight: 900;
}

.brand-subtitle {
  margin-top: 8px;
  font-size: 14px;
  color: #94a3b8;
}

.tip {
  margin-bottom: 12px;
  font-size: 14px;
  color: #6b7280;
}

.phone-input {
  width: 100%;
  height: 46px;
  padding: 0 14px;
  border-radius: 12px;
  background-color: #f8fafc;
  border: 1px solid #e2e8f0;
  margin-bottom: 16px;
  font-size: 15px;
  color: #0f172a;
}

.wechat-btn {
  width: 100%;
  height: 52px;
  border-radius: 12px;
  justify-content: center;
  align-items: center;
  background-color: #16a34a;
}

.wechat-btn-text {
  color: #ffffff;
  font-size: 17px;
  font-weight: 800;
}
</style>
