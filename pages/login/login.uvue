  margin-top: 14px;
  font-size: 32px;
  font-weight: 900;
  color: #fffef9;
  line-height: 40px;
  font-family: 'Georgia', 'Noto Serif SC', serif;
}

.subtitle {
  margin-top: 10px;
  font-size: 14px;
  color: rgba(250, 241, 225, 0.9);
  line-height: 20px;
}

.form-group {
  margin-top: 24px;
}

.input-shell {
  margin-top: 12px;
  height: 50px;
  border-radius: 50px;
  padding: 0 16px;
  background-color: rgba(255, 255, 255, 0.16);
  border-width: 1px;
  border-style: solid;
  border-color: rgba(255, 255, 255, 0.34);
  justify-content: center;
  overflow: hidden;
}

.input-shell:first-child {
  margin-top: 0;
}

.input {
  width: 100%;
  height: 100%;
  border-radius: 50px;
  background-color: rgba(255, 255, 255, 0.02) !important;
  border-width: 0;
  color: rgba(255, 255, 255, 0.98);
  font-size: 14px;
  font-weight: 600;
  padding: 0 2px;
  -webkit-appearance: none;
  appearance: none;
}

.input-placeholder {
  color: rgba(245, 248, 252, 0.78);
  font-size: 13px;
}

/* 彻底干掉浏览器自动填充的底色 */
.input:-webkit-autofill,
.input:-webkit-autofill:hover,
.input:-webkit-autofill:focus,
.input:-webkit-autofill:active {
  -webkit-text-fill-color: rgba(255, 255, 255, 0.98) !important;
  /* 重点1：去掉那层半透明的 shadow，不需要它盖了 */
  -webkit-box-shadow: none !important;
  box-shadow: none !important;
  /* 重点2：利用无限时长的过渡动画，把背景颜色的变化“冻结”在透明状态 */
  transition: background-color 9999s ease-in-out 0s !important;
  background-color: transparent !important;
}

.btn {
  margin-top: 12px;
  height: 46px;
  border-radius: 23px;
  justify-content: center;
  align-items: center;
}

.btn-login {
  margin-top: 24px;
  background-image: linear-gradient(115deg, #3f6f4a 0%, #5f8a4b 100%);
  box-shadow: 0 8px 20px rgba(38, 82, 45, 0.42);
}

.btn-register {
  background-color: rgba(224, 122, 63, 0.16);
  border-width: 1px;
  border-style: solid;
  border-color: rgba(240, 183, 136, 0.82);
}

.btn-text {
  color: #ffffff;
  font-size: 14px;
  font-weight: 900;
  letter-spacing: 1px;
}

.btn-text-ghost {
  color: rgba(255, 237, 206, 0.98);
}

.hint {
  margin-top: 18px;
  color: rgba(255, 234, 201, 0.86);
