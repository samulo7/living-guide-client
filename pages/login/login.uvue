<template>
  <view class="page">
    <image class="bg-scene" src="/static/images/4.jpg" mode="aspectFill"></image>
    <view class="bg-warm-overlay"></view>
    <view class="bg-light bg-light-a"></view>
    <view class="bg-light bg-light-b"></view>

    <view class="card-shell">
      <view class="card">
        <text class="eyebrow">NOMAD GUIDE</text>
        <text class="title">欢迎回来</text>
        <text class="subtitle">使用手机号和密码继续你的旅居计划</text>

        <view class="form-group">
          <view class="input-shell">
            <input
              class="input"
              :value="phone"
              maxlength="20"
              placeholder-class="input-placeholder"
              placeholder="请输入手机号"
              type="number"
              @input="onPhoneInput"
              @blur="onPhoneInput"
            />
          </view>
          <view class="input-shell">
            <input
              class="input"
              :value="password"
              maxlength="32"
              password
              placeholder-class="input-placeholder"
              placeholder="请输入密码（至少 6 位）"
              type="text"
              @input="onPasswordInput"
              @blur="onPasswordInput"
            />
          </view>
        </view>

        <view class="btn btn-login" @click="submitAuth('login')">
          <text class="btn-text">{{ submitting ? '处理中...' : '登录' }}</text>
        </view>
        <view class="btn btn-register" @click="submitAuth('register')">
          <text class="btn-text btn-text-ghost">{{ submitting ? '处理中...' : '注册' }}</text>
        </view>

        <text class="hint">测试账号：13800000000 / 123456</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref } from 'vue'

type AuthAction = 'login' | 'register'

interface AuthResponse {
  success: boolean
  token?: string
  message?: string
}

const API_BASE_URL = 'http://localhost:3000'
const TOKEN_KEY = 'token'
const phone = ref('')
const password = ref('')
const submitting = ref(false)

function readInputValue(event: any): string {
  if (event == null) {
    return ''
  }
  if (typeof event == 'string') {
    return event
  }

  const detailValue = event?.detail?.value
  if (typeof detailValue == 'string') {
    return detailValue
  }

  const targetValue = event?.target?.value
  if (typeof targetValue == 'string') {
    return targetValue
  }

  return ''
}

const onPhoneInput = (event: any) => {
  phone.value = readInputValue(event)
}

const onPasswordInput = (event: any) => {
  password.value = readInputValue(event)
}

function parseApiPayload<T>(raw: unknown): T | null {
  if (raw != null && typeof raw == 'object') {
    return raw as T
  }
  if (typeof raw == 'string') {
    const text = raw.trim()
    if (text == '' || text.startsWith('<!DOCTYPE') || text.startsWith('<html')) {
      return null
    }
    try {
      return JSON.parse<T>(text)
    } catch (error) {
      return null
    }
  }
  return null
}

const submitAuth = async (action: AuthAction) => {
  if (submitting.value) {
    return
  }

  const nextPhone = phone.value.replace(/\s+/g, '').trim()
  const nextPassword = password.value.trim()
  if (nextPhone == '' || nextPassword == '') {
    uni.showToast({ title: '手机号和密码不能为空', icon: 'none' })
    return
  }

  submitting.value = true
  try {
    await new Promise<void>((resolve, reject) => {
      uni.request({
        url: `${API_BASE_URL}/api/auth/${action}`,
        method: 'POST',
        data: {
          phone: nextPhone,
          password: nextPassword
        },
        success: (res) => {
          const payload = parseApiPayload<AuthResponse>(res.data)
          if ((res.statusCode != 200 && res.statusCode != 201) || payload == null || payload.success != true || payload.token == null) {
            reject(payload?.message ?? `请求失败: ${res.statusCode}`)
            return
          }

          uni.setStorageSync(TOKEN_KEY, payload.token)
          resolve()
        },
        fail: (err) => reject(err)
      })
    })

    uni.showToast({ title: action == 'login' ? '登录成功' : '注册成功', icon: 'success' })
    setTimeout(() => {
      uni.reLaunch({ url: '/pages/user/user' })
    }, 250)
  } catch (error) {
    const message = typeof error == 'string' && error != '' ? error : action == 'login' ? '登录失败' : '注册失败'
    uni.showToast({ title: message, icon: 'none' })
  } finally {
    submitting.value = false
  }
}
</script>

