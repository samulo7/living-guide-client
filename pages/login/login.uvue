  width: 100%;
  max-width: 440px;
  z-index: 2;
}

.card {
  padding: 28px 22px 22px;
  border-radius: 20px;
  background-color: rgba(252, 247, 236, 0.2);
  border-width: 1px;
  border-style: solid;
  border-color: rgba(255, 245, 223, 0.45);
  box-shadow: 0 12px 32px rgba(43, 36, 22, 0.28);
}

.eyebrow {
  font-size: 11px;
  letter-spacing: 2px;
  color: rgba(255, 245, 221, 0.9);
  font-weight: 700;
}

