  position: fixed;
  left: 12px;
  top: calc(10px + constant(safe-area-inset-top));
  top: calc(10px + env(safe-area-inset-top));
  width: 34px;
  height: 34px;
  border-radius: 17px;
  z-index: 20;
  background-color: rgba(15, 23, 42, 0.54);
  align-items: center;
  justify-content: center;
}

