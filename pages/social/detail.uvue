  font-size: 22px;
  line-height: 30px;
  color: #111827;
  font-weight: 900;
}

.author-row {
  margin-top: 14px;
  flex-direction: row;
  align-items: center;
}

.avatar-wrap {
  width: 42px;
  height: 42px;
  border-radius: 21px;
  overflow: hidden;
  background-color: #e5e7eb;
}

.avatar-image {
  width: 100%;
  height: 100%;
}

.avatar-fallback {
  width: 100%;
  height: 100%;
  align-items: center;
  justify-content: center;
}

.avatar-fallback-icon {
  font-size: 18px;
}

.author-meta {
  margin-left: 10px;
}

.nickname {
  font-size: 14px;
  color: #1f2937;
  font-weight: 800;
}

.time-text {
  margin-top: 3px;
  font-size: 11px;
  color: #94a3b8;
}

.location-line {
  margin-top: 12px;
  font-size: 13px;
  color: #334155;
}

.tag-row {
  margin-top: 12px;
  flex-direction: row;
  flex-wrap: wrap;
}

.tag-chip {
  margin-right: 7px;
  margin-bottom: 6px;
  font-size: 11px;
  border-radius: 999px;
  padding: 4px 9px;
  color: #166534;
  background-color: #f0fdf4;
  border: 1px solid #bbf7d0;
}

.content-card {
  margin: 12px 14px 0;
  border-radius: 16px;
  background-color: #ffffff;
  padding: 14px;
  box-shadow: 0 10px 24px rgba(15, 23, 42, 0.08);
}

.content-title {
  font-size: 15px;
  color: #1f2937;
  font-weight: 800;
}

.content-text {
  margin-top: 10px;
  font-size: 14px;
  line-height: 24px;
  color: #334155;
}

.contact-card {
  margin: 12px 14px 0;
  border-radius: 16px;
  background-color: #ffffff;
