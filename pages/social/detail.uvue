  margin-top: 6px;
  font-size: 12px;
  line-height: 18px;
  color: #64748b;
}

.tag-row {
  margin-top: 12px;
  flex-direction: row;
  flex-wrap: wrap;
}

.tag-chip {
  margin-right: 7px;
  margin-bottom: 6px;
  font-size: 11px;
  border-radius: 999px;
  padding: 4px 9px;
  color: #166534;
  background-color: #f0fdf4;
  border: 1px solid #bbf7d0;
}

.content-card {
  margin: 12px 14px 0;
  border-radius: 16px;
  background-color: #ffffff;
  padding: 14px;
  box-shadow: 0 10px 24px rgba(15, 23, 42, 0.08);
}

.content-title {
  font-size: 15px;
