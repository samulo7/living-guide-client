<template>
  <view class="page">
    <view class="back-btn" @click="goBack">
      <text class="back-btn-text"><</text>
    </view>

    <scroll-view class="scroll" direction="vertical">
      <view class="cover-wrap" v-if="post.images.length > 0">
        <swiper class="cover-swiper" indicator-dots circular autoplay>
          <swiper-item v-for="(img, index) in post.images" :key="img + '-' + String(index)">
            <image class="cover-image" :src="imageUrl(img)" mode="aspectFit"></image>
          </swiper-item>
        </swiper>
      </view>
      <view class="cover-empty" v-else>
        <text class="cover-empty-text">{{ '\u6682\u65e0\u56fe\u7247' }}</text>
      </view>

      <view class="main-card">
        <text class="title">{{ post.title }}</text>

        <view class="author-row">
          <view class="avatar-wrap">
            <image v-if="post.avatar != ''" class="avatar-image" :src="post.avatar" mode="aspectFill"></image>
            <view v-else class="avatar-fallback">
              <text class="avatar-fallback-icon">U</text>
            </view>
          </view>
          <view class="author-meta">
            <text class="nickname">{{ post.nickname }}</text>
            <text class="time-text">{{ post.created_at_text }}</text>
          </view>
        </view>

        <text class="location-line">{{ '\u4f4d\u7f6e\uff1a' }}{{ maskedLocationLabel }}</text>

        <view class="tag-row" v-if="post.tags.length > 0">
          <text class="tag-chip" v-for="(tag, index) in post.tags" :key="post.id + '-' + String(index)">{{ tag }}</text>
        </view>
      </view>

      <view class="content-card">
        <text class="content-title">{{ '\u5185\u5bb9' }}</text>
        <text class="content-text">{{ post.content }}</text>
      </view>

      <view class="contact-card" v-if="post.contact.trim() != ''">
        <text class="contact-label">{{ '\u8054\u7cfb\u65b9\u5f0f' }}</text>
        <text class="contact-text">{{ post.contact }}</text>
      </view>

      <view v-if="loading" class="state-wrap">
        <text class="state-text">{{ '\u6b63\u5728\u52a0\u8f7d...' }}</text>
      </view>

      <view style="height: 120px;"></view>
    </scroll-view>

    <view class="bottom-bar">
      <view class="contact-btn" :class="actionButtonClass" @click="onBottomAction">
        <text class="contact-btn-text">{{ actionButtonText }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { computed, ref } from 'vue'
import { request } from '../../utils/request'
import { buildApiUrl } from '../../utils/api'

interface SocialDetailResponse {
  ok: boolean
  data?: Record<string, unknown>
  message?: string
}

interface CompanionLocation {
  name: string
  address: string
  city: string
  latitude: number | null
  longitude: number | null
}

interface SocialDetailItem {
  id: string
  user_id: number
  nickname: string
  avatar: string
  title: string
  content: string
  tags: string[]
  contact: string
  status: number
  location: CompanionLocation | null
  images: string[]
  created_at: string
  created_at_text: string
}

const TOKEN_KEY = 'token'
const STATUS_ACTIVE = 1
const STATUS_COMPLETED = 2

const loading = ref(false)
const currentUserId = ref(0)
const post = ref<SocialDetailItem>({
  id: '',
  user_id: 0,
  nickname: '\u533f\u540d\u7528\u6237',
  avatar: '',
  title: '\u52a0\u8f7d\u4e2d...',
  content: '',
  tags: [],
  contact: '',
  status: STATUS_ACTIVE,
  location: null,
  images: [],
  created_at: '',
  created_at_text: ''
})

const isOwner = computed((): boolean => {
  return currentUserId.value > 0 && currentUserId.value == post.value.user_id
})

const isCompleted = computed((): boolean => {
  return post.value.status == STATUS_COMPLETED
})

const maskedLocationLabel = computed((): string => {
  const city = String(post.value.location?.city || '').trim()
  const name = String(post.value.location?.name || '').trim()
  const address = String(post.value.location?.address || '').trim()
  const source = name != '' ? name : address
  const shortText = pickStreetOrLandmark(stripRegionPrefix(source), city)

  if (city != '' && shortText != '' && shortText != city) {
    return city + '  ' + shortText
  }
  if (city != '') {
    return city
  }
  if (shortText != '') {
    return shortText
  }
  return '\u672a\u77e5'
})

const actionButtonText = computed((): string => {
  if (isCompleted.value) {
    return '\u5df2\u6210\u56e2/\u5df2\u7ed3\u675f'
  }
  if (isOwner.value) {
    return '\u7f16\u8f91/\u7ba1\u7406'
  }
  return '\u60f3\u8981\u8054\u7cfb'
})

const actionButtonClass = computed((): string => {
  if (isCompleted.value) {
    return 'contact-btn-disabled'
  }
  if (isOwner.value) {
    return 'contact-btn-owner'
  }
  return ''
})

function parseApiPayload<T>(raw: unknown): T | null {
  if (raw != null && typeof raw == 'object') {
    return raw as T
  }
  if (typeof raw == 'string') {
    const text = raw.trim()
    if (text == '') {
      return null
    }
    try {
      return JSON.parse<T>(text)
    } catch (error) {
      return null
    }
  }
  return null
}

function splitTags(rawTags: unknown): string[] {
  if (Array.isArray(rawTags)) {
    return rawTags.map((item) => String(item || '').trim()).filter((item) => item != '')
  }
  const text = String(rawTags || '').trim()
  if (text == '') {
    return []
  }
  return text
    .split(/[\u3001\uff0c,|/]+/)
    .map((item) => item.trim())
    .filter((item) => item != '')
}

function parseLocation(rawLocation: unknown): CompanionLocation | null {
  const source = parseApiPayload<Record<string, unknown>>(rawLocation)
  if (source == null) {
    return null
  }

  const name = String(source.name || '').trim()
  const address = String(source.address || '').trim()
  const city = String(source.city || '').trim()
  const latitude = Number(source.latitude ?? NaN)
  const longitude = Number(source.longitude ?? NaN)

  if (name == '' && address == '' && city == '' && !Number.isFinite(latitude) && !Number.isFinite(longitude)) {
    return null
  }

  return {
    name,
    address,
    city,
    latitude: Number.isFinite(latitude) ? latitude : null,
    longitude: Number.isFinite(longitude) ? longitude : null
  }
}

function parseImages(rawImages: unknown): string[] {
  if (!Array.isArray(rawImages)) {
    return []
  }
  return rawImages.map((item) => String(item || '').trim()).filter((item) => item != '')
}

function formatBeijingTimeLabel(raw: unknown): string {
  const source = String(raw || '').trim()
  if (source == '') {
    return '\u521a\u521a'
  }
  const date = new Date(source)
  if (!Number.isFinite(date.getTime())) {
    return '\u521a\u521a'
  }

  const text = new Intl.DateTimeFormat('zh-CN', {
    timeZone: 'Asia/Shanghai',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
    hour: '2-digit',
    minute: '2-digit',
    hour12: false
  }).format(date)

  return '\u5317\u4eac\u65f6\u95f4 ' + text.replace(/\//g, '-')
}

function mapDetailRow(row: Record<string, unknown>): SocialDetailItem {
  return {
    id: String(row.id ?? ''),
    user_id: Number(row.user_id ?? 0),
    nickname: String(row.nickname ?? '').trim() || '\u533f\u540d\u7528\u6237',
    avatar: String(row.avatar ?? '').trim(),
    title: String(row.title ?? '').trim(),
    content: String(row.content ?? '').trim(),
    tags: splitTags(row.tags),
    contact: String(row.contact ?? '').trim(),
    status: Number(row.status ?? STATUS_ACTIVE),
    location: parseLocation(row.location),
    images: parseImages(row.images),
    created_at: String(row.created_at ?? '').trim(),
    created_at_text: formatBeijingTimeLabel(row.created_at)
  }
}

function imageUrl(pathValue: string): string {
  const text = String(pathValue || '').trim()
  if (text == '') {
    return ''
  }
  if (text.startsWith('http://') || text.startsWith('https://')) {
    return text
  }
  return buildApiUrl(text)
}

function stripRegionPrefix(value: string): string {
  let text = String(value || '').replace(/[\uff0c,]/g, '').replace(/\s+/g, '').trim()
  if (text == '') {
    return ''
  }

  const patterns = [
    /^[\u4e00-\u9fa5]{2,}(?:\u7701|\u81ea\u6cbb\u533a|\u7279\u522b\u884c\u653f\u533a)/,
    /^[\u4e00-\u9fa5]{2,}\u5e02/,
    /^[\u4e00-\u9fa5]{1,}(?:\u533a|\u53bf|\u65d7|\u76df|\u5dde)/
  ]

  let changed = true
  while (changed && text != '') {
    changed = false
    for (let i = 0; i < patterns.length; i++) {
      const next = text.replace(patterns[i], '').trim()
      if (next != text) {
        text = next
        changed = true
      }
    }
  }
  return text
}

function escapeRegExp(value: string): string {
  return String(value || '').replace(/[.*+?^${}()|[\]\\]/g, '\\$&')
}

function pickStreetOrLandmark(value: string, city: string): string {
  let text = String(value || '').trim()
  if (city != '') {
    const cityPattern = new RegExp(escapeRegExp(city), 'g')
    text = text.replace(cityPattern, '').trim()
  }
  if (text == '') {
    return ''
  }

  const marker = text.match(
    /([\u4e00-\u9fa5A-Za-z0-9]{2,}(?:\u8def|\u8857|\u9053|\u5df7|\u5546\u5708|\u5e7f\u573a|\u4e2d\u5fc3|\u56ed\u533a|\u516c\u56ed|\u5730\u94c1\u7ad9|\u8f66\u7ad9|\u5927\u5b66|\u5b66\u9662|\u5c0f\u533a|\u793e\u533a))/
  )

  if (marker != null && String(marker[1] || '').trim() != '') {
    return String(marker[1] || '').trim()
  }

  const parts = text.split(/[-\s]/).map((item) => item.trim()).filter((item) => item != '')
  const tail = parts.length > 0 ? parts[parts.length - 1] : text
  const compact = tail.replace(/[0-9\u4e00-\u9fa5]+(?:\u53f7|\u680b|\u5e62|\u5c42|\u5355\u5143|\u5ba4).*/, '').trim()
  return compact != '' ? compact : tail
}

function readCurrentUserId(): number {
  const token = String(uni.getStorageSync(TOKEN_KEY) || '').trim()
  if (token == '') {
    return 0
  }
  const raw = uni.getStorageSync('userInfo')
  if (raw == null || typeof raw != 'object') {
    return 0
  }
  const id = Number((raw as Record<string, unknown>).id ?? 0)
  return Number.isInteger(id) && id > 0 ? id : 0
}

async function fetchDetail(id: string) {
  loading.value = true
  try {
    const payload = await request<SocialDetailResponse>({
      url: '/api/social/detail/' + encodeURIComponent(id),
      method: 'GET'
    })
    if (payload.ok !== true || payload.data == null) {
      throw new Error(payload.message || 'detail is empty')
    }
    post.value = mapDetailRow(payload.data)
  } catch (error) {
    console.error('[social-detail] fetch failed:', error)
    uni.showToast({ title: '\u52a0\u8f7d\u5931\u8d25', icon: 'none' })
  } finally {
    loading.value = false
  }
}

function contactAuthor() {
  const contact = post.value.contact.trim()
  if (contact == '') {
    uni.showToast({ title: '\u6682\u65e0\u8054\u7cfb\u65b9\u5f0f', icon: 'none' })
    return
  }
  uni.setClipboardData({
    data: contact,
    success: () => {
      uni.showToast({ title: '\u5df2\u590d\u5236', icon: 'none' })
    },
    fail: () => {
      uni.showToast({ title: contact, icon: 'none' })
    }
  })
}

function onBottomAction() {
  if (isCompleted.value) {
    uni.showToast({ title: '\u5f53\u524d\u52a8\u6001\u5df2\u7ed3\u675f', icon: 'none' })
    return
  }
  if (isOwner.value) {
    if (post.value.id.trim() == '') {
      return
    }
    uni.navigateTo({ url: '/pages/social/edit?id=' + encodeURIComponent(post.value.id) })
    return
  }
  contactAuthor()
}

function goBack() {
  uni.navigateBack({
    delta: 1,
    fail: () => {
      uni.switchTab({ url: '/pages/social/social' })
    }
  })
}

onLoad((options) => {
  currentUserId.value = readCurrentUserId()
  const id = String(options?.id || '').trim()
  if (id == '') {
    uni.showToast({ title: '\u7f3a\u5c11\u53c2\u6570', icon: 'none' })
    return
  }
  fetchDetail(id)
})

onShow(() => {
  currentUserId.value = readCurrentUserId()
})
</script>

<style scoped>
