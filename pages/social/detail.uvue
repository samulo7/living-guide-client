  color: #334155;
}

.contact-card {
  margin: 12px 14px 0;
  border-radius: 16px;
  background-color: #ffffff;
  padding: 14px;
  box-shadow: 0 10px 24px rgba(15, 23, 42, 0.08);
}

.contact-label {
  font-size: 13px;
  color: #475569;
}

.contact-text {
  margin-top: 8px;
  font-size: 14px;
