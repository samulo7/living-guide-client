<template>
  <view class="page">
    <view class="bg-orb bg-orb-a"></view>
    <view class="bg-orb bg-orb-b"></view>
    <scroll-view class="form-scroll" direction="vertical">
      <view class="form-shell">
        <view class="form-card">
          <view class="hero">
            <text class="title">{{ '发布搭子' }}</text>
            <text class="subtitle">{{ '补充关键信息，发布后更容易被同城用户看到' }}</text>
          </view>

          <view class="section-block">
            <view class="section-head">
              <text class="section-title">{{ '基础信息' }}</text>
              <text class="section-desc">{{ '先说明活动主题和预期' }}</text>
            </view>

            <view class="label-row">
              <text class="label">{{ '标题' }} <text class="required-star">*</text></text>
              <text class="label-counter">{{ titleCountText }}</text>
            </view>
            <input
              class="input"
              :class="{ 'field-invalid': shouldShowError(titleError) }"
              v-model="formTitle"
              maxlength="160"
              :placeholder="'例如：周末一起看房 / 吃饭'"
            />
            <text class="error-text" v-if="shouldShowError(titleError)">{{ titleError }}</text>

            <view class="label-row">
              <text class="label">{{ '内容' }} <text class="required-star">*</text></text>
              <text class="label-counter">{{ contentCountText }}</text>
            </view>
            <textarea
              class="textarea"
              :class="{ 'field-invalid': shouldShowError(contentError) }"
              v-model="formContent"
              maxlength="2000"
              :placeholder="'写清时间、地点、希望的搭子类型和注意事项'"
            />
            <text class="error-text" v-if="shouldShowError(contentError)">{{ contentError }}</text>
          </view>

          <view class="section-block">
            <view class="section-head">
              <text class="section-title">{{ '活动信息' }}</text>
              <text class="section-desc">{{ '完善标签、位置和图片，提高匹配效率' }}</text>
            </view>

            <view class="label-row">
              <text class="label">{{ '标签（可多选）' }} <text class="required-star">*</text></text>
              <text class="label-counter">{{ tagCountText }}</text>
            </view>
            <view class="tag-selector">
              <view
                v-for="tag in TAG_OPTIONS"
                :key="tag"
                class="tag-option"
                :class="{ 'tag-option-active': isTagSelected(tag) }"
                @click="toggleTag(tag)"
              >
                <text class="tag-option-text">{{ tag }}</text>
              </view>
            </view>
            <text class="helper-text">{{ '至少选择 1 个标签，最多 8 个' }}</text>
            <text class="error-text" v-if="shouldShowError(tagsError)">{{ tagsError }}</text>

            <text class="label">{{ '位置（必选）' }} <text class="required-star">*</text></text>
            <view class="location-card" :class="{ 'field-invalid': shouldShowError(locationError) }" @click="pickLocation">
              <view class="location-main-row">
                <text class="location-main">{{ locationSummary }}</text>
                <text class="location-status" :class="{ 'location-status-active': hasSelectedLocation }">{{ locationStatusText }}</text>
              </view>
              <text class="location-sub">{{ locationAddressText }}</text>
            </view>
            <text class="error-text" v-if="shouldShowError(locationError)">{{ locationError }}</text>
            <view class="manual-location-toggle" @click="enableManualLocation">
              <text class="manual-location-toggle-text">{{ manualLocationToggleText }}</text>
            </view>
            <view class="manual-location" v-if="manualLocationEnabled">
              <input
                class="input"
                v-model="manualLocationCity"
                maxlength="40"
                :placeholder="'城市（如：沈阳）'"
              />
              <input
                class="input manual-location-gap"
                v-model="manualLocationName"
                maxlength="80"
                :placeholder="'地点名称（如：皇姑万象汇）'"
              />
              <input
                class="input manual-location-gap"
                v-model="manualLocationAddress"
                maxlength="160"
                :placeholder="'详细地址（选填）'"
              />
              <view class="manual-location-save" @click="saveManualLocation">
                <text class="manual-location-save-text">{{ '保存手动位置' }}</text>
              </view>
            </view>

            <view class="label-row">
              <text class="label">{{ '图片（可选，最多 3 张）' }}</text>
              <text class="label-counter">{{ imageCountText }}</text>
            </view>
            <view class="image-grid">
              <view class="image-cell image-add" v-if="imagePaths.length < 3" @click="chooseImages">
                <text class="image-add-plus">+</text>
                <text class="image-add-text">{{ '添加' }}</text>
              </view>
              <view class="image-cell" v-for="(img, index) in imagePaths" :key="img + '-' + String(index)">
                <image class="image-preview" :src="imageUrl(img)" mode="aspectFill"></image>
                <view class="image-remove" @click="removeImage(index)">
                  <text class="image-remove-text">x</text>
                </view>
              </view>
            </view>
            <text class="helper-text">{{ imageHelperText }}</text>
          </view>

          <view class="section-block section-last">
            <view class="section-head">
              <text class="section-title">{{ '联系与发布' }}</text>
              <text class="section-desc">{{ '联系方式选填，方便感兴趣的人联系你' }}</text>
            </view>

            <text class="label">{{ '联系方式（选填）' }}</text>
            <input
              class="input"
              v-model="formContact"
              maxlength="120"
              :placeholder="'例如：微信号 / 电话 / Telegram'"
            />
            <text class="safety-inline-tip">{{ '安全提示：线下见面请优先选择公共场所' }}</text>
          </view>

          <view class="form-bottom-spacer"></view>
        </view>
      </view>
    </scroll-view>

    <view class="submit-bar">
      <view class="submit-inner">
        <text class="submit-state">{{ submitHintText }}</text>
        <view class="submit-btn" :class="{ 'submit-btn-disabled': !canSubmit }" @click="onSubmit">
          <text class="submit-btn-text">{{ submitText }}</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { computed, ref } from 'vue'
import { request } from '../../utils/request'
import { buildApiUrl } from '../../utils/api'

interface PublishResponse {
  success?: boolean
  id?: number
  code?: string
  message?: string
}

interface UploadImageResponse {
  success?: boolean
  path?: string
  message?: string
}

interface SelectedLocation {
  name: string
  address: string
  city: string
  latitude: number | null
  longitude: number | null
}

const TOKEN_KEY = 'token'
const REFRESH_SOCIAL_LIST_EVENT = 'REFRESH_SOCIAL_LIST'
const PUBLISH_LIMIT_DAILY = 'DAILY_LIMIT'
const PUBLISH_LIMIT_ACTIVE = 'ACTIVE_LIMIT'
const TAG_OPTIONS: string[] = [
  '看房',
  '探店',
  '饭搭子',
  '周末活动',
  '运动',
  '学习',
  '散步',
  '拼车'
]

const formTitle = ref('')
const formContent = ref('')
const formContact = ref('')
const selectedTags = ref<string[]>([])
const selectedLocation = ref<SelectedLocation | null>(null)
const imagePaths = ref<string[]>([])
const uploadingImages = ref(false)
const submitting = ref(false)
const manualLocationEnabled = ref(false)
const manualLocationCity = ref('')
const manualLocationName = ref('')
const manualLocationAddress = ref('')
const attemptedSubmit = ref(false)

const normalizedTags = computed((): string[] => {
  return selectedTags.value.slice(0, 8)
})

const locationSummary = computed((): string => {
  const location = selectedLocation.value
  if (location == null) {
    return '点击选择活动位置'
  }
  const name = location.name.trim()
  if (name != '') {
    return name
  }
  const city = location.city.trim()
  if (city != '') {
    return city
  }
  return '已选择位置'
})

const locationAddressText = computed((): string => {
  const location = selectedLocation.value
  if (location == null) {
    return '将调用地图选点，也可切换手动填写'
  }
  const address = location.address.trim()
  if (address != '') {
    return address
  }
  const city = location.city.trim()
  return city != '' ? city : '可继续补充详细地址'
})

const hasSelectedLocation = computed((): boolean => {
  return resolveLocationForSubmit() != null
})

const locationStatusText = computed((): string => {
  return hasSelectedLocation.value ? '已填写' : '待填写'
})

const manualLocationToggleText = computed((): string => {
  if (manualLocationEnabled.value) {
    return '已切换手动填写，可直接编辑下方位置'
  }
  return '地图不可用？改为手动填写位置'
})

const submitText = computed((): string => {
  if (uploadingImages.value) {
    return '图片上传中，请稍候'
  }
  if (submitting.value) {
    return '正在发布，请稍候'
  }
  if (!canSubmit.value) {
    return '完成必填后发布'
  }
  return '发布搭子'
})

const titleError = computed((): string => {
  return formTitle.value.trim().length >= 2 ? '' : '请填写至少 2 个字的标题'
})

const contentError = computed((): string => {
  return formContent.value.trim().length >= 2 ? '' : '请填写至少 2 个字的内容'
})

const tagsError = computed((): string => {
  return normalizedTags.value.length > 0 ? '' : '请至少选择 1 个标签'
})

const locationError = computed((): string => {
  return resolveLocationForSubmit() != null ? '' : '请填写活动位置'
})

const canSubmit = computed((): boolean => {
  if (submitting.value || uploadingImages.value) {
    return false
  }
  return titleError.value == '' && contentError.value == '' && tagsError.value == '' && locationError.value == ''
})

const titleCountText = computed((): string => {
  return String(formTitle.value.length) + '/160'
})

const contentCountText = computed((): string => {
  return String(formContent.value.length) + '/2000'
})

const tagCountText = computed((): string => {
  return String(normalizedTags.value.length) + '/8'
})

const imageCountText = computed((): string => {
  return String(imagePaths.value.length) + '/3'
})

const imageHelperText = computed((): string => {
  if (uploadingImages.value) {
    return '图片上传中，请稍候'
  }
  return imagePaths.value.length > 0 ? '第一张将作为封面图展示' : '可选上传，最多 3 张'
})

const submitHintText = computed((): string => {
  if (uploadingImages.value) {
    return '图片上传中，上传完成后可发布'
  }
  if (submitting.value) {
    return '正在提交，请稍候'
  }
  if (canSubmit.value) {
    return '信息完整，可直接发布'
  }
  if (titleError.value != '') {
    return titleError.value
  }
  if (contentError.value != '') {
    return contentError.value
  }
  if (tagsError.value != '') {
    return tagsError.value
  }
  return locationError.value != '' ? locationError.value : '请完善必填信息后发布'
})

function hasToken(): boolean {
  return String(uni.getStorageSync(TOKEN_KEY) || '').trim() != ''
}

function parseApiPayload<T>(raw: unknown): T | null {
  if (raw != null && typeof raw == 'object') {
    return raw as T
  }
  if (typeof raw == 'string') {
    const text = raw.trim()
    if (text == '') {
      return null
    }
    try {
      return JSON.parse<T>(text)
    } catch (error) {
      return null
    }
  }
  return null
}

function deriveCityFromAddress(address: string): string {
  const text = String(address || '').trim()
  if (text == '') {
    return ''
  }
  const match = text.match(/([一-龥A-Za-z]+?(?:市|州|区|县))/)
  return match != null ? String(match[1] || '').trim() : ''
}

function joinUniqueLocationParts(parts: string[]): string {
  const unique: string[] = []
  for (let i = 0; i < parts.length; i++) {
    const text = String(parts[i] || '').trim()
    if (text == '' || unique.includes(text)) {
      continue
    }
    unique.push(text)
  }
  return unique.join(' ')
}

function trimToAreaOrStreet(textValue: string): string {
  const text = String(textValue || '').trim().replace(/\s+/g, '')
  if (text == '') {
    return ''
  }
  const streetMatch = text.match(/^(.*?(?:路|街|道|巷|大道|胡同|大街|步行街))/)
  if (streetMatch != null && String(streetMatch[1] || '').trim() != '') {
    return String(streetMatch[1] || '').trim()
  }
  const areaMatch = text.match(/^(.*?(?:广场|商圈|园区|中心|万达|万象城|天地|城))/)
  if (areaMatch != null && String(areaMatch[1] || '').trim() != '') {
    return String(areaMatch[1] || '').trim()
  }
  return text
    .replace(/([0-9一-龥]+(?:号|弄|栋|幢|单元|室|楼|层).*)$/, '')
    .replace(/[，,].*$/, '')
    .trim()
}

function buildMaskedAreaFromChooseResult(result: Record<string, unknown>): string {
  const district = String(result.district || '').trim()
  const businessArea = String(result.businessArea || '').trim()
  const street = String(result.street || '').trim()
  const township = String(result.township || '').trim()
  const rawAddress = String(result.address || '').trim()
  const rawName = String(result.name || result.poiName || '').trim()
  const areaOrStreet = trimToAreaOrStreet(businessArea || street || township || rawAddress || rawName)
  return joinUniqueLocationParts([district, areaOrStreet]).trim()
}

function buildMaskedAddress(city: string, area: string, rawAddress: string): string {
  const fallback = trimToAreaOrStreet(rawAddress)
  return joinUniqueLocationParts([city, area != '' ? area : fallback]).trim()
}

function mapChooseLocationResult(result: Record<string, unknown>): SelectedLocation {
  const rawAddress = String(result.address || '').trim()
  const cityRaw = String(result.city || result.district || result.province || '').trim()
  const city = cityRaw != '' ? cityRaw : deriveCityFromAddress(rawAddress)
  const area = buildMaskedAreaFromChooseResult(result)
  const maskedAddress = buildMaskedAddress(city, area, rawAddress)
  const latitude = Number(result.latitude ?? NaN)
  const longitude = Number(result.longitude ?? NaN)

  return {
    name: area != '' ? area : (city != '' ? city + '周边' : '附近'),
    address: maskedAddress,
    city,
    latitude: Number.isFinite(latitude) ? latitude : null,
    longitude: Number.isFinite(longitude) ? longitude : null
  }
}

function asRecord(value: unknown): Record<string, unknown> | null {
  return value != null && typeof value == 'object' ? (value as Record<string, unknown>) : null
}

function readNestedRecord(source: unknown, key: string): Record<string, unknown> | null {
  const record = asRecord(source)
  if (record == null) {
    return null
  }
  return asRecord(record[key])
}

function isWebPlatform(): boolean {
  try {
    return String(uni.getSystemInfoSync().uniPlatform || '').toLowerCase() == 'web'
  } catch (error) {
    return false
  }
}

function isPlaceholderValue(value: string): boolean {
  const text = value.trim()
  if (text == '') {
    return true
  }
  return text.includes('这里填入') || text.includes('请填写')
}

function getWebAmapConfig(): { key: string; securityJsCode: string; detected: boolean } {
  const globalObj = asRecord(globalThis)
  const uniConfig =
    readNestedRecord(globalObj, '__uniConfig') ||
    readNestedRecord(globalObj, '__UNI_CONFIG__') ||
    readNestedRecord(globalObj, '__uniappConfig')

  if (uniConfig == null) {
    return { key: '', securityJsCode: '', detected: false }
  }

  const sdkConfigs = readNestedRecord(uniConfig, 'sdkConfigs')
  const maps = readNestedRecord(sdkConfigs, 'maps')
  const amap = readNestedRecord(maps, 'amap')

  return {
    key: String(amap?.key || '').trim(),
    securityJsCode: String(amap?.securityJsCode || '').trim(),
    detected: amap != null
  }
}

function hasValidWebAmapConfig(): boolean {
  if (!isWebPlatform()) {
    return true
  }
  const amapConfig = getWebAmapConfig()
  if (!amapConfig.detected) {
    // Some runtimes do not expose manifest config on global variables.
    return true
  }
  return !isPlaceholderValue(amapConfig.key) && !isPlaceholderValue(amapConfig.securityJsCode)
}

function mapErrorText(error: unknown): string {
  if (typeof error == 'string') {
    return error
  }
  if (error != null && typeof error == 'object') {
    const record = error as Record<string, unknown>
    const errMsg = String(record.errMsg || '').trim()
    if (errMsg != '') {
      return errMsg
    }
    const message = String(record.message || '').trim()
    if (message != '') {
      return message
    }
  }
  return ''
}

function isMapProviderMissingError(error: unknown): boolean {
  const text = mapErrorText(error).toLowerCase()
  if (text == '') {
    return false
  }
  return (
    text.includes('map key not configured') ||
    text.includes('map provider not configured') ||
    text.includes('uni-config-center/uni-map/config.js') ||
    text.includes('sdkconfigs.maps.amap') ||
    text.includes('securityjscode')
  )
}

function isMapPluginMissingError(error: unknown): boolean {
  const text = mapErrorText(error).toLowerCase()
  if (text == '') {
    return false
  }
  return (
    text.includes('plugin') ||
    text.includes('地图插件') ||
    text.includes('amap is not defined') ||
    text.includes('amap sdk') ||
    text.includes('chooselocation:fail')
  )
}

function isMapServiceSystemError(error: unknown): boolean {
  const text = mapErrorText(error).toLowerCase()
  if (text == '') {
    return false
  }
  return text.includes('system_error') || text.includes('[uni-map-co]') || text.includes('unknown system error')
}

function isChooseLocationCanceled(error: unknown): boolean {
  const text = mapErrorText(error).toLowerCase()
  return text.includes('cancel')
}

function buildManualLocation(): SelectedLocation | null {
  const city = manualLocationCity.value.trim()
  const name = trimToAreaOrStreet(manualLocationName.value)
  const address = trimToAreaOrStreet(manualLocationAddress.value)
  if (city == '' && name == '' && address == '') {
    return null
  }
  const resolvedName = name != '' ? name : (address != '' ? address : city)
  const resolvedCity = city != '' ? city : deriveCityFromAddress(address)
  return {
    name: resolvedName,
    address: joinUniqueLocationParts([resolvedCity, address != '' ? address : resolvedName]),
    city: resolvedCity,
    latitude: null,
    longitude: null
  }
}

function resolveLocationForSubmit(): SelectedLocation | null {
  if (selectedLocation.value != null) {
    return selectedLocation.value
  }
  return buildManualLocation()
}

function syncManualLocationFields(location: SelectedLocation | null) {
  if (location == null) {
    return
  }
  manualLocationCity.value = location.city
  manualLocationName.value = location.name
  manualLocationAddress.value = location.address
}

function enableManualLocation() {
  manualLocationEnabled.value = true
  syncManualLocationFields(selectedLocation.value)
}

function saveManualLocation(): boolean {
  const location = buildManualLocation()
  if (location == null) {
    uni.showToast({ title: '请至少填写一项位置信息', icon: 'none' })
    return false
  }
  selectedLocation.value = location
  uni.showToast({ title: '手动位置已保存', icon: 'none' })
  return true
}
function shouldShowError(message: string): boolean {
  return attemptedSubmit.value && message != ''
}

function handlePublishLimitResponse(response: PublishResponse): boolean {
  const code = String(response.code || '').trim()
  if (code == PUBLISH_LIMIT_DAILY) {
    uni.showToast({ title: '今日发帖次数已达上限，请明天再来', icon: 'none' })
    return true
  }
  if (code == PUBLISH_LIMIT_ACTIVE) {
    uni.showModal({
      title: '发布受限',
      content: response.message || '当前正在招募的动态已达上限，请先去管理页结束旧动态',
      confirmText: '去管理页',
      cancelText: '我知道了',
      success: (result) => {
        if (!result.confirm) {
          return
        }
        uni.navigateTo({ url: '/pages/user/my-companions' })
      }
    })
    return true
  }
  return false
}

function normalizeImageUrlProtocol(url: string): string {
  const text = String(url || '').trim()
  if (!text.startsWith('http://')) {
    return text
  }
  const host = text.slice('http://'.length).split('/')[0].toLowerCase()
  if (
    host.startsWith('localhost') ||
    host.startsWith('127.') ||
    host.startsWith('10.') ||
    host.startsWith('192.168.') ||
    host.startsWith('172.')
  ) {
    return text
  }
  return 'https://' + text.slice('http://'.length)
}

function imageUrl(pathValue: string): string {
  const text = String(pathValue || '').trim()
  if (text == '') {
    return ''
  }
  if (text.startsWith('http://') || text.startsWith('https://')) {
    return normalizeImageUrlProtocol(text)
  }
  return normalizeImageUrlProtocol(buildApiUrl(text))
}

function isTagSelected(tag: string): boolean {
  return selectedTags.value.includes(tag)
}

function toggleTag(tag: string) {
  if (submitting.value || uploadingImages.value) {
    return
  }
  const index = selectedTags.value.findIndex((item) => item == tag)
  if (index >= 0) {
    selectedTags.value.splice(index, 1)
    return
  }
  if (selectedTags.value.length >= 8) {
    uni.showToast({ title: '最多选择 8 个标签', icon: 'none' })
    return
  }
  selectedTags.value.push(tag)
}

function pickLocation() {
  if (submitting.value || uploadingImages.value) {
    return
  }

  if (!hasValidWebAmapConfig()) {
    const amapConfig = getWebAmapConfig()
    console.error('[social-publish] Map key not configured', amapConfig)
    enableManualLocation()
    uni.showToast({ title: '地图暂不可用，已切换手动填写', icon: 'none' })
    return
  }

  try {
    uni.chooseLocation({
      provider: 'amap',
      success: (res) => {
        const mapped = mapChooseLocationResult(res as unknown as Record<string, unknown>)
        selectedLocation.value = mapped
        manualLocationEnabled.value = false
        syncManualLocationFields(mapped)
      },
      fail: (error) => {
        if (isChooseLocationCanceled(error)) {
          return
        }
        console.error('[social-publish] chooseLocation failed:', error)
        if (isMapProviderMissingError(error) || isMapPluginMissingError(error) || isMapServiceSystemError(error)) {
          enableManualLocation()
          uni.showToast({ title: '地图服务异常，已切换手动填写', icon: 'none' })
          return
        }
        uni.showToast({ title: '定位失败，请重试或手动填写', icon: 'none' })
      }
    })
  } catch (error) {
    console.error('[social-publish] chooseLocation crashed:', error)
    enableManualLocation()
    uni.showToast({ title: '地图服务异常，已切换手动填写', icon: 'none' })
  }
}
function removeImage(index: number) {
  if (submitting.value || uploadingImages.value) {
    return
  }
  if (index < 0 || index >= imagePaths.value.length) {
    return
  }
  imagePaths.value.splice(index, 1)
}

function authHeaders(): UTSJSONObject {
  const token = String(uni.getStorageSync(TOKEN_KEY) || '').trim()
  const header = new UTSJSONObject()
  if (token == '') {
    return header
  }
  header.set('Authorization', 'Bearer ' + token)
  return header
}

async function uploadImage(filePath: string): Promise<string> {
  return new Promise<string>((resolve, reject) => {
    uni.uploadFile({
      url: buildApiUrl('/api/social/upload-image'),
      filePath,
      name: 'file',
      header: authHeaders(),
      success: (res) => {
        if (res.statusCode != 200 && res.statusCode != 201) {
          reject('upload failed: ' + res.statusCode)
          return
        }
        const payload = parseApiPayload<UploadImageResponse>(res.data)
        if (payload == null || payload.success !== true || String(payload.path || '').trim() == '') {
          reject(payload?.message || 'invalid upload response')
          return
        }
        resolve(String(payload.path || '').trim())
      },
      fail: (error) => reject(error)
    })
  })
}

async function chooseImages() {
  if (submitting.value || uploadingImages.value) {
    return
  }
  if (!hasToken()) {
    uni.showToast({ title: '请先登录后再上传图片', icon: 'none' })
    uni.navigateTo({ url: '/pages/login/login' })
    return
  }

  const remain = Math.max(0, 3 - imagePaths.value.length)
  if (remain <= 0) {
    uni.showToast({ title: '最多上传 3 张图片', icon: 'none' })
    return
  }

  uni.chooseImage({
    count: remain,
    sizeType: ['compressed'],
    sourceType: ['album', 'camera'],
    success: async (res) => {
      const paths = Array.isArray(res.tempFilePaths) ? res.tempFilePaths : []
      if (paths.length == 0) {
        return
      }
      uploadingImages.value = true
      try {
        for (let i = 0; i < paths.length; i++) {
          const uploadedPath = await uploadImage(String(paths[i] || ''))
          if (uploadedPath != '') {
            imagePaths.value.push(uploadedPath)
          }
          if (imagePaths.value.length >= 3) {
            break
          }
        }
      } catch (error) {
        console.error('[social-publish] upload image failed:', error)
        uni.showToast({ title: '图片上传失败，请重试', icon: 'none' })
      } finally {
        uploadingImages.value = false
      }
    },
    fail: (error) => {
      console.error('[social-publish] chooseImage failed:', error)
    }
  })
}

async function onSubmit() {
  attemptedSubmit.value = true

  if (!hasToken()) {
    uni.showToast({ title: '请先登录后再发布', icon: 'none' })
    uni.navigateTo({ url: '/pages/login/login' })
    return
  }

  const title = formTitle.value.trim()
  const content = formContent.value.trim()
  const tags = normalizedTags.value
  const contact = formContact.value.trim()

  if (!canSubmit.value) {
    if (titleError.value != '') {
      uni.showToast({ title: titleError.value, icon: 'none' })
      return
    }
    if (contentError.value != '') {
      uni.showToast({ title: contentError.value, icon: 'none' })
      return
    }
    if (tagsError.value != '') {
      uni.showToast({ title: tagsError.value, icon: 'none' })
      return
    }
    if (locationError.value != '') {
      uni.showToast({ title: locationError.value, icon: 'none' })
      return
    }
    return
  }

  const resolvedLocation = resolveLocationForSubmit()
  if (resolvedLocation == null) {
    return
  }
  selectedLocation.value = resolvedLocation

  if (submitting.value || uploadingImages.value || selectedLocation.value == null) {
    return
  }

  submitting.value = true
  try {
    const res = await request<PublishResponse>({
      url: '/api/social/publish',
      method: 'POST',
      data: {
        title,
        content,
        tags,
        location: selectedLocation.value,
        images: imagePaths.value,
        contact
      }
    })

    if (res.success !== true) {
      if (handlePublishLimitResponse(res)) {
        return
      }
      uni.showToast({ title: res.message || '发布失败', icon: 'none' })
      return
    }

    uni.showToast({ title: '发布成功', icon: 'none' })
    uni.$emit(REFRESH_SOCIAL_LIST_EVENT)
    setTimeout(() => {
      uni.navigateBack()
    }, 900)
  } catch (error) {
    console.error('[social-publish] failed:', error)
    uni.showToast({ title: '发布失败，请稍后重试', icon: 'none' })
  } finally {
    submitting.value = false
  }
}
</script>

