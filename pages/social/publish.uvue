<template>
  <view class="page">
    <view class="form-card">
      <text class="title">发布搭子</text>

      <text class="label">标题</text>
      <input
        class="input"
        v-model="formTitle"
        maxlength="160"
        placeholder="例如：周末一起看房+吃饭"
      />

      <text class="label">内容</text>
      <textarea
        class="textarea"
        v-model="formContent"
        maxlength="2000"
        placeholder="写清楚时间、地点、你希望的搭子类型"
      />

      <text class="label">标签（用逗号分隔）</text>
      <input
        class="input"
        v-model="formTags"
        maxlength="120"
        placeholder="例如：看房,探店,周末"
      />

      <view class="submit-btn" @click="onSubmit">
        <text class="submit-btn-text">{{ submitting ? '发布中...' : '立即发布' }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref } from 'vue'
import { request } from '../../utils/request'

interface PublishResponse {
  ok: boolean
  message?: string
}

const SOCIAL_REFRESH_KEY = 'social_need_refresh'

const formTitle = ref('')
const formContent = ref('')
const formTags = ref('')
const submitting = ref(false)

function parseTags(text: string): string[] {
  return String(text || '')
    .split(/[,\uff0c\u3001|]/)
    .map((item) => item.trim())
    .filter((item) => item != '')
    .slice(0, 8)
}

async function onSubmit() {
  const title = formTitle.value.trim()
  const content = formContent.value.trim()
  const tags = parseTags(formTags.value)

  if (title.length < 2) {
    uni.showToast({ title: '标题至少 2 个字', icon: 'none' })
    return
  }
  if (content.length < 2) {
    uni.showToast({ title: '内容至少 2 个字', icon: 'none' })
    return
  }

  if (submitting.value) {
    return
  }

  submitting.value = true
  try {
    const res = await request<PublishResponse>({
      url: '/api/social/publish',
      method: 'POST',
      data: {
        title,
        content,
        tags
      }
    })

    if (res.ok !== true) {
      uni.showToast({ title: res.message || '发布失败', icon: 'none' })
      return
    }

    uni.setStorageSync(SOCIAL_REFRESH_KEY, '1')
    uni.showToast({ title: '发布成功', icon: 'none' })
    setTimeout(() => {
      uni.navigateBack()
    }, 220)
  } catch (error) {
    console.error('[social-publish] failed:', error)
    uni.showToast({ title: '发布失败，请稍后重试', icon: 'none' })
  } finally {
    submitting.value = false
  }
}
</script>

<style scoped>
.page {
  min-height: 100vh;
  background-color: #f5f7f6;
  padding: 18px 14px;
}

.form-card {
  background-color: #ffffff;
  border-radius: 16px;
  padding: 16px;
  box-shadow: 0 10px 22px rgba(17, 24, 39, 0.08);
}

.title {
  font-size: 24px;
  color: #0f172a;
  font-weight: 900;
}

.label {
  margin-top: 14px;
  margin-bottom: 6px;
  font-size: 13px;
  color: #4b5563;
}

.input {
  height: 44px;
  border-radius: 10px;
  border: 1px solid #dbe3ea;
  background-color: #f8fafc;
  padding: 0 12px;
  font-size: 14px;
  color: #0f172a;
}

.textarea {
  min-height: 128px;
  border-radius: 10px;
  border: 1px solid #dbe3ea;
  background-color: #f8fafc;
  padding: 10px 12px;
  font-size: 14px;
  color: #0f172a;
}

.submit-btn {
  margin-top: 18px;
  height: 46px;
  border-radius: 12px;
  align-items: center;
  justify-content: center;
  background-color: #16a34a;
}

.submit-btn-text {
  font-size: 16px;
  color: #ffffff;
  font-weight: 800;
}
</style>
