<template>
  <view class="page">
    <view class="hero">
      <view class="hero-row">
        <view>
          <text class="hero-title">搭子广场</text>
          <text class="hero-subtitle">一个人躺平太无聊？找个同频搭子</text>
        </view>
        <view class="mode-toggle" @click="toggleViewMode">
          <text class="mode-toggle-text">
            {{ viewMode == 'list' ? '切换雷达' : '切换列表' }}
          </text>
        </view>
      </view>
    </view>

    <view class="mode-stage">
      <view class="list-mode" :class="{ 'mode-active': viewMode == 'list', 'mode-hidden': viewMode != 'list' }">
        <scroll-view class="list-scroll" direction="vertical">
          <view v-if="loading" class="state-wrap">
            <text class="state-text">正在连接附近游民...</text>
          </view>

          <view v-else-if="companions.length == 0" class="state-wrap">
            <text class="state-text">暂时还没有搭子动态</text>
          </view>

          <view v-else class="feed-list">
            <view class="feed-card" v-for="item in companions" :key="item.id">
              <view class="feed-head">
                <view class="avatar-wrap">
                  <image v-if="item.avatar != ''" class="avatar-image" :src="item.avatar" mode="aspectFill"></image>
                  <view v-else class="avatar-fallback">
                    <text class="avatar-fallback-icon">👤</text>
                  </view>
                </view>

                <view class="head-meta">
                  <view class="meta-row">
                    <text class="nickname">{{ item.nickname }}</text>
                    <text class="city-chip">📍 {{ cityText(item.city_name) }}</text>
                  </view>
                  <text class="time-text">{{ item.created_at_text }}</text>
                </view>
              </view>

              <text class="feed-title">{{ item.title }}</text>
              <text class="feed-content">{{ item.content }}</text>

              <view class="tag-row" v-if="item.tags.length > 0">
                <text
                  v-for="(tag, index) in item.tags"
                  :key="item.id + '-' + index"
                  :class="['tag-chip', 'tag-chip-' + String(index % 4)]"
                >
                  {{ tag }}
                </text>
              </view>
            </view>
          </view>
          <view style="height: 24px;"></view>
        </scroll-view>
      </view>

      <view class="radar-mode" :class="{ 'mode-active': viewMode == 'radar', 'mode-hidden': viewMode != 'radar' }">
        <view class="radar-container">
          <view class="radar-center-layer">
            <view
              class="ripple"
              v-for="index in 4"
              :key="'ripple-' + String(index)"
              :style="{ animationDelay: String((index - 1) * 0.8) + 's' }"
            ></view>
            <view class="scanner-line"></view>

            <view class="center-user">
              <image class="center-user-avatar" src="/static/logo.png" mode="aspectFill"></image>
            </view>

            <view
              v-for="node in radarNodes"
              :key="'node-' + node.id"
              class="radar-node"
              :style="node.style"
              @click="pingCompanion(node.nickname)"
            >
              <image v-if="node.avatar != ''" class="radar-node-avatar" :src="node.avatar" mode="aspectFill"></image>
              <view v-else class="radar-node-fallback">
                <text class="radar-node-fallback-icon">👤</text>
              </view>
            </view>
          </view>

          <view class="radar-tip">
            <text class="radar-tip-text">已发现 {{ radarNodes.length }} 位附近同频游民</text>
          </view>
        </view>
      </view>
    </view>

    <view class="publish-fab" @click="goPublish">
      <text class="publish-fab-text">+</text>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref } from 'vue'

interface CompanionListResponse {
  ok: boolean
  data?: Record<string, unknown>[]
  message?: string
}

interface CompanionItem {
  id: string
  nickname: string
  avatar: string
  city_name: string
  title: string
  content: string
  tags: string[]
  created_at_text: string
}

interface RadarNode {
  id: string
  nickname: string
  avatar: string
  style: {
    top: string
    left: string
  }
}

const API_BASE_URL = 'http://localhost:3000'
const REFRESH_SOCIAL_LIST_EVENT = 'REFRESH_SOCIAL_LIST'
const TOKEN_KEY = 'token'

const viewMode = ref<'list' | 'radar'>('list')
const loading = ref(true)
const companions = ref<CompanionItem[]>([])
const radarNodes = ref<RadarNode[]>([])

function toggleViewMode() {
  viewMode.value = viewMode.value == 'list' ? 'radar' : 'list'
}

function parseApiPayload<T>(raw: unknown): T | null {
  if (raw != null && typeof raw == 'object') {
    return raw as T
  }
  if (typeof raw == 'string') {
    const text = raw.trim()
    if (text == '') {
      return null
    }
    try {
      return JSON.parse<T>(text)
    } catch (error) {
      return null
    }
  }
  return null
}

function splitTags(rawTags: unknown): string[] {
  if (Array.isArray(rawTags)) {
    return rawTags
      .map((item) => String(item || '').trim())
      .filter((item) => item != '')
  }
  const text = String(rawTags || '').trim()
  if (text == '') {
    return []
  }
  return text
    .split(/[、，,|/]+/)
    .map((item) => item.trim())
    .filter((item) => item != '')
}

function formatTimeLabel(raw: unknown): string {
  const source = String(raw || '').trim()
  if (source == '') {
    return '刚刚发布'
  }
  const time = new Date(source).getTime()
  if (!Number.isFinite(time)) {
    return '刚刚发布'
  }
  const diff = Date.now() - time
  if (diff < 60 * 1000) {
    return '刚刚发布'
  }
  if (diff < 60 * 60 * 1000) {
    return String(Math.max(1, Math.floor(diff / (60 * 1000)))) + ' 分钟前'
  }
  if (diff < 24 * 60 * 60 * 1000) {
    return String(Math.max(1, Math.floor(diff / (60 * 60 * 1000)))) + ' 小时前'
  }
  return String(Math.max(1, Math.floor(diff / (24 * 60 * 60 * 1000)))) + ' 天前'
}

function cityText(value: string): string {
  const text = String(value || '').trim()
  return text != '' ? text : '城市待定'
}

function mapCompanionRow(row: Record<string, unknown>): CompanionItem {
  return {
    id: String(row.id ?? ''),
    nickname: String(row.nickname ?? '').trim() || '匿名游民',
    avatar: String(row.avatar ?? '').trim(),
    city_name: String(row.city_name ?? '').trim(),
    title: String(row.title ?? '').trim(),
    content: String(row.content ?? '').trim(),
    tags: splitTags(row.tags),
    created_at_text: formatTimeLabel(row.created_at)
  }
}

function randomInRange(min: number, max: number): number {
  return Math.round((Math.random() * (max - min) + min) * 10) / 10
}

function buildRadarNodes(rows: CompanionItem[]): RadarNode[] {
  const selected = rows.slice(0, 4)
  return selected.map((item) => {
    let top = randomInRange(20, 80)
    let left = randomInRange(10, 90)
    let attempts = 0

    while (attempts < 8 && top > 40 && top < 60 && left > 35 && left < 65) {
      top = randomInRange(20, 80)
      left = randomInRange(10, 90)
      attempts += 1
    }

    return {
      id: item.id,
      nickname: item.nickname,
      avatar: item.avatar,
      style: {
        top: String(top) + '%',
        left: String(left) + '%'
      }
    }
  })
}

function pingCompanion(nickname: string) {
  void nickname
  uni.showToast({
    title: '正在向该游民发起心跳信号...',
    icon: 'none'
  })
}

async function fetchCompanions(): Promise<CompanionItem[]> {
  return new Promise<CompanionItem[]>((resolve, reject) => {
    uni.request({
      url: API_BASE_URL + '/api/companions',
      method: 'GET',
      success: (res) => {
        if (res.statusCode != 200) {
          reject('request failed: ' + res.statusCode)
          return
        }
        const payload = parseApiPayload<CompanionListResponse>(res.data)
        if (payload == null || payload.ok != true || !Array.isArray(payload.data)) {
          reject(payload?.message ?? 'companions is empty')
          return
        }
        resolve(payload.data.map((item) => mapCompanionRow(item)))
      },
      fail: (error) => reject(error)
    })
  })
}

function hasToken(): boolean {
  return String(uni.getStorageSync(TOKEN_KEY) || '').trim() != ''
}

function goPublish() {
  if (!hasToken()) {
    uni.showToast({ title: '请先登录后再发布', icon: 'none' })
    uni.navigateTo({ url: '/pages/login/login' })
    return
  }
  uni.navigateTo({ url: '/pages/social/publish' })
}

async function fetchData() {
  loading.value = true
  try {
    const rows = await fetchCompanions()
    companions.value = rows
    radarNodes.value = buildRadarNodes(rows)
  } catch (error) {
    console.error('[social] load companions failed:', error)
    companions.value = []
    radarNodes.value = []
    uni.showToast({ title: '加载搭子动态失败', icon: 'none' })
  } finally {
    loading.value = false
  }
}

function onRefreshSocialList() {
  fetchData()
}

onLoad(async () => {
  uni.$off(REFRESH_SOCIAL_LIST_EVENT, onRefreshSocialList)
  uni.$on(REFRESH_SOCIAL_LIST_EVENT, onRefreshSocialList)
  await fetchData()
})

onUnload(() => {
  uni.$off(REFRESH_SOCIAL_LIST_EVENT, onRefreshSocialList)
})
</script>

