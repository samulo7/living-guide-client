  margin-top: 6px;
  font-size: 14px;
  color: #4b5563;
}

.feed {
  height: calc(100vh - 130px);
  padding: 12px 14px 0;
}

.publish-fab {
  position: fixed;
  right: 18px;
  bottom: 28px;
  width: 56px;
  height: 56px;
  border-radius: 28px;
  align-items: center;
  justify-content: center;
  background-color: #16a34a;
  box-shadow: 0 10px 22px rgba(22, 163, 74, 0.38);
}

.publish-fab-text {
  font-size: 34px;
  line-height: 34px;
  color: #ffffff;
  font-weight: 700;
}

