  padding-top: 88px;
  align-items: center;
}

.state-text {
  font-size: 14px;
  color: #8c8c8c;
}

.post-card {
  margin-bottom: 14px;
  background-color: #ffffff;
  border-radius: 16px;
  padding: 14px;
  box-shadow: 0 10px 22px rgba(17, 24, 39, 0.08);
}

.post-head {
  flex-direction: row;
  align-items: center;
}

.avatar {
  width: 44px;
  height: 44px;
  border-radius: 22px;
  background-color: #f3f4f6;
}

.avatar-fallback {
  width: 44px;
  height: 44px;
  border-radius: 22px;
  align-items: center;
  justify-content: center;
  background-color: #e5e7eb;
}

.avatar-fallback-icon {
  font-size: 19px;
  color: #6b7280;
}

.author-info {
  flex: 1;
  margin-left: 10px;
}

.nickname {
  font-size: 15px;
  color: #111827;
  font-weight: 800;
}

.tagline {
  margin-top: 2px;
  font-size: 12px;
  color: #64748b;
}

.meta {
  margin-top: 3px;
  font-size: 12px;
  color: #94a3b8;
}

.post-title {
  margin-top: 12px;
  font-size: 20px;
  line-height: 28px;
  color: #0f172a;
  font-weight: 900;
  lines: 2;
  text-overflow: ellipsis;
}

.post-content {
  margin-top: 9px;
  font-size: 14px;
  line-height: 22px;
  color: #475569;
  lines: 3;
  text-overflow: ellipsis;
}

.cover-image {
  margin-top: 10px;
  height: 164px;
  border-radius: 10px;
}

.tag-row {
  margin-top: 12px;
  flex-direction: row;
  flex-wrap: wrap;
}

.tag-chip {
  margin-right: 7px;
  margin-bottom: 6px;
  font-size: 11px;
  border-radius: 999px;
  padding: 4px 9px;
}

.tag-chip-0 {
  color: #9a3412;
  background-color: #fff7ed;
  border: 1px solid #fed7aa;
}

.tag-chip-1 {
  color: #166534;
  background-color: #f0fdf4;
  border: 1px solid #bbf7d0;
}

.tag-chip-2 {
  color: #1d4ed8;
  background-color: #eff6ff;
  border: 1px solid #bfdbfe;
}

.tag-chip-3 {
  color: #0f766e;
  background-color: #f0fdfa;
  border: 1px solid #99f6e4;
}

.tag-chip-4 {
  color: #7c2d12;
