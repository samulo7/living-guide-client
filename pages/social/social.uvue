<template>
  <view class="page">
    <scroll-view class="main-scroll" direction="vertical">
      <view class="hero">
        <text class="hero-title">搭子广场</text>
        <text class="hero-subtitle">科学找搭子，先看雷达再看动态</text>
      </view>

      <view class="radar-section">
        <view class="radar-container">
          <view class="radar-center-layer">
            <view
              class="ripple"
              v-for="index in 4"
              :key="'ripple-' + String(index)"
              :style="{ animationDelay: String((index - 1) * 0.8) + 's' }"
            ></view>
            <view class="scanner-line"></view>

            <view class="center-user">
              <image class="center-user-avatar" src="/static/logo.png" mode="aspectFill"></image>
            </view>

            <view
              v-for="node in radarNodes"
              :key="'node-' + node.id"
              class="radar-node"
              :style="node.style"
              @click="pingCompanion(node.nickname)"
            >
              <image v-if="node.avatar != ''" class="radar-node-avatar" :src="node.avatar" mode="aspectFill"></image>
              <view v-else class="radar-node-fallback">
                <text class="radar-node-fallback-icon">👤</text>
              </view>
            </view>
          </view>

          <view class="radar-tip">
            <text class="radar-tip-text">已发现 {{ radarNodes.length }} 位附近同频游民</text>
          </view>
        </view>
      </view>

      <view class="feed-section">
        <text class="feed-title">最新动态</text>

        <view v-if="loading" class="state-wrap">
          <text class="state-text">正在连接附近游民...</text>
        </view>

        <view v-else-if="companions.length == 0" class="state-wrap">
          <text class="state-text">暂时还没有搭子动态</text>
        </view>

        <view v-else class="feed-list">
          <view class="feed-card" v-for="item in companions" :key="item.id" @click="goDetail(item.id)">
            <view class="feed-head">
              <view class="avatar-wrap">
                <image v-if="item.avatar != ''" class="avatar-image" :src="item.avatar" mode="aspectFill"></image>
                <view v-else class="avatar-fallback">
                  <text class="avatar-fallback-icon">👤</text>
                </view>
              </view>

              <view class="head-meta">
                <view class="meta-row">
                  <text class="nickname">{{ item.nickname }}</text>
                  <text class="time-text">{{ item.created_at_text }}</text>
                </view>
                <text class="city-chip">📍 {{ locationLabel(item) }}</text>
              </view>
            </view>

            <text class="card-title">{{ item.title }}</text>
            <text class="card-content">{{ item.content }}</text>

            <image
              v-if="item.images.length > 0"
              class="card-cover"
              :src="imageUrl(item.images[0])"
              mode="aspectFill"
            ></image>

            <view class="tag-row" v-if="item.tags.length > 0">
              <text
                v-for="(tag, index) in item.tags"
                :key="item.id + '-' + index"
                :class="['tag-chip', 'tag-chip-' + String(index % 4)]"
              >
                {{ tag }}
              </text>
            </view>
          </view>
        </view>
      </view>

      <view style="height: 96px;"></view>
    </scroll-view>

    <view class="publish-fab" @click="goPublish">
      <text class="publish-fab-text">+</text>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref } from 'vue'
import { request } from '../../utils/request'
import { buildApiUrl } from '../../utils/api'

interface SocialListResponse {
  ok: boolean
  data?: Record<string, unknown>[]
  message?: string
}

interface CompanionLocation {
  name: string
  address: string
  city: string
  latitude: number | null
  longitude: number | null
}

interface CompanionItem {
  id: string
  nickname: string
  avatar: string
  title: string
  content: string
  tags: string[]
  location: CompanionLocation | null
  images: string[]
  created_at: string
  created_at_text: string
}

interface RadarNode {
  id: string
  nickname: string
  avatar: string
  style: {
    top: string
    left: string
  }
}

const TOKEN_KEY = 'token'
const REFRESH_SOCIAL_LIST_EVENT = 'REFRESH_SOCIAL_LIST'

const loading = ref(true)
const companions = ref<CompanionItem[]>([])
const radarNodes = ref<RadarNode[]>([])

function parseApiPayload<T>(raw: unknown): T | null {
  if (raw != null && typeof raw == 'object') {
    return raw as T
  }
  if (typeof raw == 'string') {
    const text = raw.trim()
    if (text == '') {
      return null
    }
    try {
      return JSON.parse<T>(text)
    } catch (error) {
      return null
    }
  }
  return null
}

function splitTags(rawTags: unknown): string[] {
  if (Array.isArray(rawTags)) {
    return rawTags
      .map((item) => String(item || '').trim())
      .filter((item) => item != '')
  }
  const text = String(rawTags || '').trim()
  if (text == '') {
    return []
  }
  return text
    .split(/[、，,|/]+/)
    .map((item) => item.trim())
    .filter((item) => item != '')
}

function parseLocation(rawLocation: unknown): CompanionLocation | null {
  const source = parseApiPayload<Record<string, unknown>>(rawLocation)
  if (source == null) {
    return null
  }

  const name = String(source.name || '').trim()
  const address = String(source.address || '').trim()
  const city = String(source.city || '').trim()
  const latitude = Number(source.latitude ?? NaN)
  const longitude = Number(source.longitude ?? NaN)

  if (name == '' && address == '' && city == '' && !Number.isFinite(latitude) && !Number.isFinite(longitude)) {
    return null
  }

  return {
    name,
    address,
    city,
    latitude: Number.isFinite(latitude) ? latitude : null,
    longitude: Number.isFinite(longitude) ? longitude : null
  }
}

function parseImages(rawImages: unknown): string[] {
  if (!Array.isArray(rawImages)) {
    return []
  }
  return rawImages
    .map((item) => String(item || '').trim())
    .filter((item) => item != '')
}

function formatBeijingTimeLabel(raw: unknown): string {
  const source = String(raw || '').trim()
  if (source == '') {
    return '刚刚发布'
  }
  const date = new Date(source)
  if (!Number.isFinite(date.getTime())) {
    return '刚刚发布'
  }

  const text = new Intl.DateTimeFormat('zh-CN', {
    timeZone: 'Asia/Shanghai',
    month: '2-digit',
    day: '2-digit',
    hour: '2-digit',
    minute: '2-digit',
    hour12: false
  }).format(date)

  return '北京 ' + text.replace(/\//g, '-')
}

function mapCompanionRow(row: Record<string, unknown>): CompanionItem {
  return {
    id: String(row.id ?? ''),
    nickname: String(row.nickname ?? '').trim() || '匿名游民',
    avatar: String(row.avatar ?? '').trim(),
    title: String(row.title ?? '').trim(),
    content: String(row.content ?? '').trim(),
    tags: splitTags(row.tags),
    location: parseLocation(row.location),
    images: parseImages(row.images),
    created_at: String(row.created_at ?? '').trim(),
    created_at_text: formatBeijingTimeLabel(row.created_at)
  }
}

function randomInRange(min: number, max: number): number {
  return Math.round((Math.random() * (max - min) + min) * 10) / 10
}

function buildRadarNodes(rows: CompanionItem[]): RadarNode[] {
  const selected = rows.slice(0, 4)
  return selected.map((item) => {
    let top = randomInRange(20, 80)
    let left = randomInRange(10, 90)
    let attempts = 0

    while (attempts < 8 && top > 40 && top < 60 && left > 35 && left < 65) {
      top = randomInRange(20, 80)
      left = randomInRange(10, 90)
      attempts += 1
    }

    return {
      id: item.id,
      nickname: item.nickname,
      avatar: item.avatar,
      style: {
        top: String(top) + '%',
        left: String(left) + '%'
      }
    }
  })
}

function locationLabel(item: CompanionItem): string {
  const city = String(item.location?.city || '').trim()
  const name = String(item.location?.name || '').trim()
  if (city != '' && name != '') {
    return city + ' · ' + name
  }
  if (city != '') {
    return city
  }
  if (name != '') {
    return name
  }
  return '位置待定'
}

function normalizeImageUrlProtocol(url: string): string {
  const text = String(url || '').trim()
  if (!text.startsWith('http://')) {
    return text
  }
  const host = text.slice('http://'.length).split('/')[0].toLowerCase()
  if (
    host.startsWith('localhost') ||
    host.startsWith('127.') ||
    host.startsWith('10.') ||
    host.startsWith('192.168.') ||
    host.startsWith('172.')
  ) {
    return text
  }
  return 'https://' + text.slice('http://'.length)
}

function imageUrl(pathValue: string): string {
  const text = String(pathValue || '').trim()
  if (text == '') {
    return ''
  }
  if (text.startsWith('http://') || text.startsWith('https://')) {
    return normalizeImageUrlProtocol(text)
  }
  return normalizeImageUrlProtocol(buildApiUrl(text))
}

function pingCompanion(nickname: string) {
  uni.showToast({
    title: '正在向 ' + nickname + ' 发起信号...',
    icon: 'none'
  })
}

async function fetchCompanions(): Promise<CompanionItem[]> {
  const payload = await request<SocialListResponse>({
    url: '/api/social/list',
    method: 'GET'
  })
  if (payload.ok !== true || !Array.isArray(payload.data)) {
    throw new Error(payload.message || 'social list is empty')
  }
  return payload.data.map((item) => mapCompanionRow(item))
}

function hasToken(): boolean {
  return String(uni.getStorageSync(TOKEN_KEY) || '').trim() != ''
}

function goPublish() {
  if (!hasToken()) {
    uni.showToast({ title: '请先登录后再发布', icon: 'none' })
    uni.navigateTo({ url: '/pages/login/login' })
    return
  }
  uni.navigateTo({ url: '/pages/social/publish' })
}

function goDetail(id: string) {
  const postId = String(id || '').trim()
  if (postId == '') {
    return
  }
  uni.navigateTo({
    url: '/pages/social/detail?id=' + encodeURIComponent(postId)
  })
}

async function fetchData() {
  loading.value = true
  try {
    const rows = await fetchCompanions()
    companions.value = rows
    radarNodes.value = buildRadarNodes(rows)
  } catch (error) {
    console.error('[social] load list failed:', error)
    companions.value = []
    radarNodes.value = []
    uni.showToast({ title: '加载搭子动态失败', icon: 'none' })
  } finally {
    loading.value = false
  }
}

function onRefreshSocialList() {
  fetchData()
}

onLoad(async () => {
  uni.$off(REFRESH_SOCIAL_LIST_EVENT, onRefreshSocialList)
  uni.$on(REFRESH_SOCIAL_LIST_EVENT, onRefreshSocialList)
  await fetchData()
})

onUnload(() => {
  uni.$off(REFRESH_SOCIAL_LIST_EVENT, onRefreshSocialList)
})
</script>

