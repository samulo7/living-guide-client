<template>
  <view class="page">
    <view class="hero">
      <text class="hero-title">搭子广场</text>
      <text class="hero-subtitle">一个人躺平太无聊？找个同频搭子</text>
      <view class="hero-tips">
        <text class="hero-tip">同城组局</text>
        <text class="hero-tip">社恐友好</text>
        <text class="hero-tip">即时响应</text>
      </view>
    </view>

    <scroll-view class="feed" direction="vertical">
      <view v-if="loading" class="state-wrap">
        <text class="state-text">正在加载搭子动态...</text>
      </view>

      <view v-else-if="companionList.length == 0" class="state-wrap">
        <text class="state-text">广场暂时还没有新帖子</text>
      </view>

      <view v-else class="card-list">
        <view class="post-card" v-for="post in companionList" :key="post.id">
          <view class="post-head">
            <image v-if="post.avatar != ''" class="avatar" :src="post.avatar" mode="aspectFill"></image>
            <view v-else class="avatar-fallback">
              <text class="avatar-fallback-icon">👤</text>
            </view>

            <view class="author-info">
              <text class="nickname">{{ post.nickname }}</text>
              <text class="meta">📍 {{ post.city_name }} · 发布于 {{ post.created_at_text }}</text>
            </view>
          </view>

          <text class="post-title">{{ post.title }}</text>
          <text class="post-content">{{ post.content }}</text>

          <view class="tag-row" v-if="post.tags.length > 0">
            <text
              v-for="(tag, index) in post.tags"
              :key="post.id + '-' + index"
              :class="['tag-chip', 'tag-chip-' + String(index % 5)]"
            >
              {{ tag }}
            </text>
          </view>
        </view>
      </view>

      <view style="height: 18px;"></view>
    </scroll-view>

    <view class="publish-fab" @click="goPublish">
      <text class="publish-fab-text">+</text>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref } from 'vue'

interface CompanionListResponse {
  ok: boolean
  data?: Record<string, unknown>[]
  message?: string
}

interface CompanionItem {
  id: string
  nickname: string
  avatar: string
  city_name: string
  title: string
  content: string
  tags: string[]
  created_at_text: string
}

const API_BASE_URL = 'http://localhost:3000'
const SOCIAL_REFRESH_KEY = 'social_need_refresh'
const TOKEN_KEY = 'token'

const loading = ref(true)
const companionList = ref<CompanionItem[]>([])

function parseApiPayload<T>(raw: unknown): T | null {
  if (raw != null && typeof raw == 'object') {
    return raw as T
  }
  if (typeof raw == 'string') {
    const text = raw.trim()
    if (text == '') {
      return null
    }
    try {
      return JSON.parse<T>(text)
    } catch (error) {
      return null
    }
  }
  return null
}

function splitTags(rawTags: unknown): string[] {
  if (Array.isArray(rawTags)) {
    return rawTags
      .map((item) => String(item || '').trim())
      .filter((item) => item != '')
  }
  const text = String(rawTags || '').trim()
  if (text == '') {
    return []
  }
  return text
    .split(/[、,，;；|/]+/)
    .map((item) => item.trim())
    .filter((item) => item != '')
}

function formatCreatedAt(raw: unknown): string {
  const text = String(raw || '').trim()
  if (text == '') {
    return '--'
  }
  const date = new Date(text)
  if (Number.isNaN(date.getTime())) {
    return text
  }
  const y = String(date.getFullYear())
  const m = String(date.getMonth() + 1).padStart(2, '0')
  const d = String(date.getDate()).padStart(2, '0')
  const hh = String(date.getHours()).padStart(2, '0')
  const mm = String(date.getMinutes()).padStart(2, '0')
  return y + '-' + m + '-' + d + ' ' + hh + ':' + mm
}

function mapCompanionRow(row: Record<string, unknown>): CompanionItem {
  const city = String(row.city_name ?? '').trim()
  return {
    id: String(row.id ?? ''),
    nickname: String(row.nickname ?? '').trim() || '匿名搭子',
    avatar: String(row.avatar ?? '').trim(),
    city_name: city != '' ? city : '未知城市',
    title: String(row.title ?? '').trim(),
    content: String(row.content ?? '').trim(),
    tags: splitTags(row.tags),
    created_at_text: formatCreatedAt(row.created_at)
  }
}

async function fetchCompanions(): Promise<CompanionItem[]> {
  return new Promise<CompanionItem[]>((resolve, reject) => {
    uni.request({
      url: API_BASE_URL + '/api/companions',
      method: 'GET',
      success: (res) => {
        if (res.statusCode != 200) {
          reject('request failed: ' + res.statusCode)
          return
        }
        const payload = parseApiPayload<CompanionListResponse>(res.data)
        if (payload == null || payload.ok != true || !Array.isArray(payload.data)) {
          reject(payload?.message ?? 'companions is empty')
          return
        }
        resolve(payload.data.map((item) => mapCompanionRow(item)))
      },
      fail: (error) => reject(error)
    })
  })
}

function hasToken(): boolean {
  return String(uni.getStorageSync(TOKEN_KEY) || '').trim() != ''
}

function goPublish() {
  if (!hasToken()) {
    uni.showToast({ title: '请先登录后再发布', icon: 'none' })
    uni.navigateTo({ url: '/pages/login/login' })
    return
  }
  uni.navigateTo({ url: '/pages/social/publish' })
}

async function loadCompanions() {
  loading.value = true
  try {
    companionList.value = await fetchCompanions()
  } catch (error) {
    console.error('[social] load companions failed:', error)
    companionList.value = []
    uni.showToast({ title: '加载搭子动态失败', icon: 'none' })
  } finally {
    loading.value = false
  }
}

onLoad(async () => {
  await loadCompanions()
})

onShow(() => {
  const needRefresh = String(uni.getStorageSync(SOCIAL_REFRESH_KEY) || '').trim()
  if (needRefresh == '1') {
    uni.removeStorageSync(SOCIAL_REFRESH_KEY)
    loadCompanions()
  }
})
</script>

