  margin-top: 12px;
  flex-direction: row;
  flex-wrap: wrap;
}

.hero-tip {
  margin-right: 8px;
  margin-bottom: 6px;
  font-size: 11px;
  color: #7f1d1d;
  border-radius: 999px;
  padding: 4px 10px;
  border: 1px solid rgba(239, 68, 68, 0.26);
  background-color: rgba(255, 255, 255, 0.75);
}

