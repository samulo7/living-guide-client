  height: 54px;
  background-color: #ffffff;
}

.city-wrap {
  flex-direction: row;
  align-items: center;
  padding: 9px 14px;
}

.city-chip {
  margin-right: 8px;
  border-radius: 16px;
  padding: 6px 12px;
  background-color: #f3f4f6;
  border: 1px solid transparent;
}

.city-chip-active {
  background-color: #ecfdf3;
  border-color: #16a34a;
}

.city-chip-text {
  font-size: 13px;
  color: #6b7280;
}

.city-chip-text-active {
  color: #166534;
  font-weight: 700;
}

.list-scroll {
  height: calc(100vh - 168px);
  padding: 12px 14px 0;
}

.state-wrap {
  padding-top: 88px;
  align-items: center;
}

.state-text {
  font-size: 14px;
  color: #8c8c8c;
}

.house-card {
  margin-bottom: 14px;
  background-color: #ffffff;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 10px 22px rgba(17, 24, 39, 0.08);
}

.card-image-wrap {
  position: relative;
  height: 188px;
}

.card-image {
  width: 100%;
  height: 100%;
}

.green-badge {
  position: absolute;
  left: 10px;
  top: 10px;
  font-size: 11px;
  color: #ffffff;
  font-weight: 700;
  border-radius: 999px;
  background-color: rgba(34, 197, 94, 0.92);
  padding: 5px 10px;
}

.price-badge {
  position: absolute;
  right: 10px;
  bottom: 10px;
  font-size: 18px;
  color: #ffffff;
  font-weight: 900;
  border-radius: 999px;
  background-image: linear-gradient(135deg, #f97316 0%, #ef4444 100%);
  padding: 7px 12px;
  box-shadow: 0 8px 18px rgba(249, 115, 22, 0.32);
}

.card-content {
  padding: 12px;
}

.card-title {
  font-size: 17px;
  line-height: 24px;
  color: #111827;
  font-weight: 900;
  lines: 2;
  text-overflow: ellipsis;
}

.card-location {
  margin-top: 7px;
  font-size: 13px;
  color: #6b7280;
}

.tag-row {
  margin-top: 10px;
  flex-direction: row;
  flex-wrap: wrap;
}

.tag-chip {
  margin-right: 7px;
  margin-bottom: 6px;
  font-size: 11px;
  color: #475569;
  border-radius: 999px;
  background-color: #f8fafc;
  border: 1px solid #e2e8f0;
  padding: 4px 9px;
}

.favorite-btn {
  margin-top: 10px;
  align-self: flex-start;
  border-radius: 999px;
  border: 1px solid #16a34a;
  background-color: #ffffff;
  padding: 5px 12px;
}

.favorite-btn-active {
  background-color: #16a34a;
}

.favorite-btn-text {
  font-size: 12px;
