<template>
  <view class="page">
    <view class="hero">
      <text class="hero-title">安家大厅</text>
      <text class="hero-subtitle">全网低价房源，从这里开始躺平</text>
      <view class="hero-tips">
        <text class="hero-tip">价格升序</text>
        <text class="hero-tip">真实城市</text>
        <text class="hero-tip">随时看房</text>
      </view>
    </view>

    <scroll-view class="city-scroll" direction="horizontal" :show-scrollbar="false">
      <view class="city-wrap">
        <view
          v-for="city in cityOptions"
          :key="city.value"
          class="city-chip"
          :class="{ 'city-chip-active': currentCity == city.value }"
          @click="selectCity(city.value)"
        >
          <text class="city-chip-text" :class="{ 'city-chip-text-active': currentCity == city.value }">
            {{ city.label }}
          </text>
        </view>
        <view style="width: 12px;"></view>
      </view>
    </scroll-view>

    <scroll-view class="list-scroll" direction="vertical">
      <view v-if="loading" class="state-wrap">
        <text class="state-text">正在加载房源...</text>
      </view>

      <view v-else-if="houseList.length == 0" class="state-wrap">
        <text class="state-text">当前城市暂无房源</text>
      </view>

      <view v-else class="card-list">
        <view
          class="house-card"
          v-for="room in houseList"
          :key="room.id"
          @click="goDetail(room.id)"
        >
          <view class="card-image-wrap">
            <image class="card-image" :src="coverUrl(room.cover_image)" mode="aspectFill"></image>
            <text class="green-badge">低价优选</text>
            <text class="price-badge">¥{{ priceText(room.price) }}/月</text>
          </view>

          <view class="card-content">
            <text class="card-title">{{ room.title }}</text>
            <text class="card-location">📍 {{ room.city_name }} · {{ room.district }}</text>
            <view class="tag-row" v-if="splitTags(room.tags).length > 0">
              <text
                class="tag-chip"
                v-for="(tag, index) in splitTags(room.tags).slice(0, 3)"
                :key="room.id + '-' + index"
              >
                {{ tag }}
              </text>
            </view>
            <view class="favorite-btn" :class="{ 'favorite-btn-active': isFavorited(room.id) }" @click.stop="onFavorite(room.id)">
              <text class="favorite-btn-text">{{ isFavorited(room.id) ? '已收藏' : '收藏' }}</text>
            </view>
          </view>
        </view>
      </view>

      <view style="height: 18px;"></view>
    </scroll-view>
  </view>
</template>

<script setup lang="ts">
import { ref } from 'vue'
import { request } from '../../utils/request'

interface HouseListResponse {
  ok: boolean
  data?: Record<string, unknown>[]
  message?: string
}

interface HouseItem {
  id: string
  city_id: string
  city_name: string
  title: string
  cover_image: string
  price: number
  district: string
  tags: string
}

interface CityOption {
  value: string
  label: string
}

interface FavoriteListResponse {
  ok: boolean
  data?: Record<string, unknown>[]
}

interface FavoriteResponse {
  ok: boolean
  message?: string
}

const API_BASE_URL = 'http://localhost:3000'
const TOKEN_KEY = 'token'

const loading = ref(true)
const houseList = ref<HouseItem[]>([])
const cityOptions = ref<CityOption[]>([{ value: 'all', label: '全部城市' }])
const currentCity = ref('all')
const cityQuery = ref('')
const favoriteMap = ref<Record<string, boolean>>({})

function parseApiPayload<T>(raw: unknown): T | null {
  if (raw != null && typeof raw == 'object') {
    return raw as T
  }
  if (typeof raw == 'string') {
    const text = raw.trim()
    if (text == '') {
      return null
    }
    try {
      return JSON.parse<T>(text)
    } catch (error) {
      return null
    }
  }
  return null
}

function mapHouseRow(row: Record<string, unknown>): HouseItem {
  return {
    id: String(row.id ?? ''),
    city_id: String(row.city_id ?? ''),
    city_name: String(row.city_name ?? ''),
    title: String(row.title ?? ''),
    cover_image: String(row.cover_image ?? ''),
    price: Number(row.price ?? 0),
    district: String(row.district ?? ''),
    tags: String(row.tags ?? '')
  }
}

async function fetchHouses(cityId: string): Promise<HouseItem[]> {
  return new Promise<HouseItem[]>((resolve, reject) => {
    const query = cityId != 'all' ? '?city_id=' + encodeURIComponent(cityId) : ''
    uni.request({
      url: API_BASE_URL + '/api/houses' + query,
      method: 'GET',
      success: (res) => {
        if (res.statusCode != 200) {
          reject('request failed: ' + res.statusCode)
          return
        }
        const payload = parseApiPayload<HouseListResponse>(res.data)
        if (payload == null || payload.ok != true || !Array.isArray(payload.data)) {
          reject(payload?.message ?? 'houses is empty')
          return
        }
        resolve(payload.data.map((item) => mapHouseRow(item)))
      },
      fail: (error) => reject(error)
    })
  })
}

function buildCityOptions(rows: HouseItem[]) {
  const map = new Map<string, string>()
  rows.forEach((item) => {
    const id = String(item.city_id || '').trim()
    const name = String(item.city_name || '').trim()
    if (id != '' && name != '' && !map.has(id)) {
      map.set(id, name)
    }
  })

  const options: CityOption[] = [{ value: 'all', label: '全部城市' }]
  map.forEach((label, value) => {
    options.push({ value, label })
  })
  cityOptions.value = options
}

function splitTags(rawTags: string): string[] {
  const text = String(rawTags || '').trim()
  if (text == '') {
    return []
  }
  return text
    .split(/[、,，;；|/]+/)
    .map((item) => item.trim())
    .filter((item) => item != '')
}

function priceText(value: number): string {
  if (!Number.isFinite(value) || value <= 0) {
    return '--'
  }
  return String(Math.round(value))
}

function coverUrl(value: string): string {
  const text = String(value || '').trim()
  if (text != '') {
    return text
  }
  return '/static/images/2.jpg'
}

function goDetail(id: string) {
  uni.navigateTo({ url: '/pages/sublet/detail?id=' + id })
}

function isFavorited(houseId: string): boolean {
  return favoriteMap.value[String(houseId)] === true
}

function hasToken(): boolean {
  return String(uni.getStorageSync(TOKEN_KEY) || '').trim() != ''
}

async function syncFavoriteMap() {
  if (!hasToken()) {
    favoriteMap.value = {}
    return
  }

  try {
    const res = await request<FavoriteListResponse>({
      url: '/api/user/favorites',
      method: 'GET'
    })
    if (res.ok !== true || !Array.isArray(res.data)) {
      return
    }

    const nextMap: Record<string, boolean> = {}
    res.data.forEach((item) => {
      const id = String(item.id || '').trim()
      if (id != '') {
        nextMap[id] = true
      }
    })
    favoriteMap.value = nextMap
  } catch (error) {
    console.error('[sublet-index] load favorites failed:', error)
  }
}

async function onFavorite(houseId: string) {
  const id = String(houseId || '').trim()
  if (id == '') {
    return
  }

  if (!hasToken()) {
    uni.showToast({ title: '请先登录后再收藏', icon: 'none' })
    uni.navigateTo({ url: '/pages/login/login' })
    return
  }

  if (isFavorited(id)) {
    uni.showToast({ title: '已在心愿单中', icon: 'none' })
    return
  }

  try {
    const res = await request<FavoriteResponse>({
      url: '/api/user/favorite',
      method: 'POST',
      data: {
        house_id: Number.parseInt(id, 10)
      }
    })
    if (res.ok !== true) {
      uni.showToast({ title: res.message || '收藏失败', icon: 'none' })
      return
    }

    favoriteMap.value = {
      ...favoriteMap.value,
      [id]: true
    }
    uni.showToast({ title: '已存入心愿单', icon: 'none' })
  } catch (error) {
    console.error('[sublet-index] favorite failed:', error)
    uni.showToast({ title: '收藏失败，请稍后重试', icon: 'none' })
  }
}

async function loadHouses(cityId: string) {
  loading.value = true
  try {
    houseList.value = await fetchHouses(cityId)
  } catch (error) {
    console.error('[sublet-index] load houses failed:', error)
    houseList.value = []
    uni.showToast({ title: '加载房源失败', icon: 'none' })
  } finally {
    loading.value = false
  }
}

async function selectCity(cityId: string) {
  if (currentCity.value == cityId) {
    return
  }
  currentCity.value = cityId
  await loadHouses(cityId)
}

onLoad(async (options) => {
  const city = options?.city
  if (city != null) {
    const decoded = decodeURIComponent(String(city))
    cityQuery.value = String(decoded || '').trim()
  }

  loading.value = true
  try {
    await syncFavoriteMap()
    const allRows = await fetchHouses('all')
    buildCityOptions(allRows)
    let filtered = allRows
    if (cityQuery.value != '') {
      const matched = cityOptions.value.find((item) => {
        if (item.value == 'all') {
          return false
        }
        const label = String(item.label || '').trim()
        if (label == '') {
          return false
        }
        return label.includes(cityQuery.value) || cityQuery.value.includes(label)
      })
      if (matched != null) {
        currentCity.value = matched.value
        filtered = allRows.filter((item) => item.city_id == matched.value)
      }
    }
    houseList.value = filtered
  } catch (error) {
    console.error('[sublet-index] init failed:', error)
    houseList.value = []
    cityOptions.value = [{ value: 'all', label: '全部城市' }]
    uni.showToast({ title: '加载房源失败', icon: 'none' })
  } finally {
    loading.value = false
  }
})

onShow(() => {
  syncFavoriteMap()
})
</script>

<style scoped>
