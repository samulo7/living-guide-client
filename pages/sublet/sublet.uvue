<template>
  <view class="page">
    <view class="header">
      <text class="title">流浪转租</text>
      <text class="subtitle">短租/转租房源，不押一付三</text>
    </view>

    <scroll-view class="city-filter" direction="horizontal" :show-scrollbar="false">
      <view class="city-wrap">
        <view
          v-for="item in cityOptions"
          :key="item.value"
          class="city-tag"
          :class="{ active: currentCity === item.value }"
          @click="currentCity = item.value"
        >
          <text :class="['city-text', currentCity === item.value ? 'active-text' : '']">{{ item.label }}</text>
        </view>
        <view style="width: 20px; height: 10px;"></view>
      </view>
    </scroll-view>

    <scroll-view class="list" direction="vertical">
      <view v-if="loading" class="state-box">
        <text class="state-text">正在加载房源...</text>
      </view>

      <view v-else-if="filteredSublets.length === 0" class="state-box">
        <text class="state-text">这个城市暂无短租房源</text>
      </view>

      <view v-else>
        <sublet-card
          v-for="room in filteredSublets"
          :key="room.id"
          :data="room"
          @click="goRoom(room.id)"
        />
      </view>
      <view style="height: 96px;"></view>
    </scroll-view>

    <tab-bar active="sublet" />
  </view>
</template>

<script setup lang="ts">
import { computed, ref } from 'vue'
import { onLoad } from '@dcloudio/uni-app'
import SubletCard from '../../components/SubletCard.uvue'
import TabBar from '../../components/TabBar.uvue'
import type { CityOption, SubletItem } from '../../types/sublet'
import { loadCityData } from '../../utils/dataLoader.ts'
import { loadSublets, filterSubletsByCity, getCityOptionsFromCityData, normalizeCityName } from '../../utils/useSublets'

const sublets = ref<SubletItem[]>([])
const loading = ref(true)
const currentCity = ref('all')
const cityOptions = ref<CityOption[]>([{ value: 'all', label: '全部城市' }])
const cityQuery = ref('')

const filteredSublets = computed(() => filterSubletsByCity(sublets.value, currentCity.value))

const applyCityQuery = () => {
  if (cityQuery.value == '') {
    return
  }
  const target = normalizeCityName(cityQuery.value)
  const found = cityOptions.value.find((item) => normalizeCityName(item.value) == target)
  if (found != null) {
    currentCity.value = found.value
  } else {
    currentCity.value = 'all'
  }
}

const initData = async () => {
  try {
    const [subletData, cityData] = await Promise.all([loadSublets(), loadCityData()])
    sublets.value = subletData
    cityOptions.value = [{ value: 'all', label: '全部城市' }, ...getCityOptionsFromCityData(cityData.items)]
    applyCityQuery()
  } catch (error) {
    uni.showToast({ title: '加载房源失败', icon: 'none' })
  } finally {
    loading.value = false
  }
}

const goRoom = (id: string) => {
  uni.navigateTo({ url: `/pages/sublet/detail?id=${id}` })
}

onLoad((options) => {
  const city = options['city']
  if (city != null) {
    cityQuery.value = decodeURIComponent(city as string)
  }
  initData()
})
</script>

<style scoped>
.page {
  height: 100vh;
  background-color: #f5f5dc;
  display: flex;
  flex-direction: column;
}

.header {
  padding: 50px 18px 14px;
  background-image: linear-gradient(135deg, #f7e7c8 0%, #e6d9b7 100%);
}

.title {
  font-size: 24px;
  color: #5a4b27;
  font-weight: 900;
}

.subtitle {
  font-size: 13px;
  color: #6e5d34;
  margin-top: 4px;
}

.city-filter {
  height: 50px;
  background-color: #ffffff;
}

.city-wrap {
  flex-direction: row;
  align-items: center;
  padding: 8px 16px;
}

.city-tag {
  background-color: #f7f7f0;
  border-radius: 16px;
  padding: 6px 14px;
  margin-right: 10px;
  border-width: 1px;
  border-style: solid;
  border-color: transparent;
}

.city-text {
  font-size: 13px;
  color: #666;
}

.active {
  background-color: #fff7e6;
  border-color: #d4b106;
}

.active-text {
  color: #7c5e10;
  font-weight: 700;
}

.list {
  flex: 1;
  padding: 12px 16px 0;
}

.state-box {
  padding-top: 60px;
  align-items: center;
}

.state-text {
  font-size: 14px;
  color: #8c8c8c;
}
</style>
