}

.state-text {
  font-size: 14px;
  color: #8c8c8c;
}

.house-card {
  margin-bottom: 14px;
  background-color: #ffffff;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 10px 22px rgba(17, 24, 39, 0.08);
}

.card-image-wrap {
  position: relative;
  height: 188px;
}

.card-image {
  width: 100%;
  height: 100%;
}

