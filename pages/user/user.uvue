<template>
  <view class="page">
    <scroll-view class="content" direction="vertical">
      <view class="hero">
        <view class="profile-card" :class="{ 'profile-card-guest': !isLogged }" @click="onProfileCardClick">
          <image v-if="userInfo?.avatar" class="avatar" :src="userInfo.avatar" mode="aspectFill"></image>
          <view v-else class="avatar-fallback">
            <text class="avatar-fallback-icon">U</text>
          </view>

          <view class="profile-main">
            <text class="nickname">{{ isLogged ? (userInfo?.username || '加载中...') : '点击登录' }}</text>
            <text v-if="(userInfo?.tagline || '') != ''" class="bio">{{ userInfo?.tagline }}</text>
          </view>
        </view>
      </view>

      <view v-if="!isLogged" class="guest-placeholder-wrap">
        <text class="guest-placeholder-text">登录后查看我的收藏</text>
      </view>

      <view v-else>
        <view class="stats-panel">
          <view class="stat-item">
            <text class="stat-label">我的发布</text>
            <text class="stat-value">{{ stats.published }}</text>
          </view>
          <view class="stat-item">
            <text class="stat-label">我的收藏</text>
            <text class="stat-value">{{ stats.favorites }}</text>
          </view>
          <view class="stat-item">
            <text class="stat-label">浏览记录</text>
            <text class="stat-value">{{ stats.history }}</text>
          </view>
        </view>

        <view class="section-head">
          <text class="section-title">我的收藏</text>
        </view>

        <view v-if="loadingFavorites" class="state-wrap">
          <text class="state-text">正在加载收藏房源...</text>
        </view>

        <view v-else-if="favoriteList.length == 0" class="state-wrap">
          <text class="state-text">你还没有收藏房源，去安家大厅看看</text>
        </view>

        <view v-else class="card-list">
          <view class="house-card" v-for="(room, index) in favoriteList" :key="room.id" @click="goDetail(room.id)">
            <view class="card-image-wrap">
              <image class="card-image" :src="coverUrl(room.cover_image)" mode="aspectFill"></image>
              <text class="green-badge">已收藏</text>
              <view class="remove-favorite-btn" @click.stop="onRemoveFavorite(room.id, index)">
                <text class="remove-favorite-text">×</text>
              </view>
              <text class="price-badge">¥{{ priceText(room.price) }}/月</text>
            </view>

            <view class="card-content">
              <text class="card-title">{{ room.title }}</text>
              <text class="card-location">📍 {{ room.city_name }} · {{ room.district }}</text>
              <view class="tag-row" v-if="splitTags(room.tags).length > 0">
                <text class="tag-chip" v-for="(tag, index) in splitTags(room.tags).slice(0, 3)" :key="room.id + '-' + index">
                  {{ tag }}
                </text>
              </view>
            </view>
          </view>
        </view>

        <view class="logout-btn" @click="onLogout">
          <text class="logout-text">退出登录</text>
        </view>
      </view>

      <view style="height: 24px;"></view>
    </scroll-view>
  </view>
</template>

<script setup lang="ts">
import { ref } from 'vue'
import { onShow } from '@dcloudio/uni-app'
import { request } from '../../utils/request'

interface ProfileResponse {
  ok: boolean
  data?: Record<string, unknown>
  message?: string
}

interface FavoriteListResponse {
  ok: boolean
  data?: Record<string, unknown>[]
  message?: string
}

interface FavoriteToggleResponse {
  ok: boolean
  data?: Record<string, unknown>
  message?: string
}

interface ProfileInfo {
  username: string
  tagline: string
  avatar: string
}

interface HouseItem {
  id: string
  city_id: string
  city_name: string
  title: string
  cover_image: string
  price: number
  district: string
  tags: string
}

const TOKEN_KEY = 'token'
const USER_INFO_KEY = 'userInfo'
const REFRESH_FAVORITES_EVENT = 'REFRESH_FAVORITES'
const REFRESH_USER_PROFILE_EVENT = 'REFRESH_USER_PROFILE'

const isLogged = ref(false)
const userInfo = ref<ProfileInfo | null>(null)
const favoriteList = ref<HouseItem[]>([])
const loadingFavorites = ref(true)
const stats = ref({
  published: 0,
  favorites: 0,
  history: 0
})

function splitTags(rawTags: string): string[] {
  const text = String(rawTags || '').trim()
  if (text == '') {
    return []
  }
  return text
    .split(/[、,，|]/)
    .map((item) => item.trim())
    .filter((item) => item != '')
}

function priceText(value: number): string {
  if (!Number.isFinite(value) || value <= 0) {
    return '--'
  }
  return String(Math.round(value))
}

function coverUrl(value: string): string {
  const text = String(value || '').trim()
  if (text != '') {
    return text
  }
  return '/static/images/2.jpg'
}

function mapHouseRow(row: Record<string, unknown>): HouseItem {
  return {
    id: String(row.id ?? ''),
    city_id: String(row.city_id ?? ''),
    city_name: String(row.city_name ?? ''),
    title: String(row.title ?? ''),
    cover_image: String(row.cover_image ?? ''),
    price: Number(row.price ?? 0),
    district: String(row.district ?? ''),
    tags: String(row.tags ?? '')
  }
}

function mapUserInfo(row: Record<string, unknown>): ProfileInfo {
  const username = String(row.username ?? '').trim()
  const tagline = String(row.tagline ?? '').trim()
  const avatar = String(row.avatar ?? '').trim()

  return {
    username: username != '' ? username : '数字游民',
    tagline: tagline != '' ? tagline : '今天也在低成本生活',
    avatar
  }
}

function saveUserInfo(next: ProfileInfo | null) {
  if (next == null) {
    uni.removeStorageSync(USER_INFO_KEY)
    return
  }
  uni.setStorageSync(USER_INFO_KEY, {
    username: next.username,
    tagline: next.tagline,
    avatar: next.avatar
  })
}

function readUserInfo(): ProfileInfo | null {
  const raw = uni.getStorageSync(USER_INFO_KEY)
  if (raw == null || typeof raw != 'object') {
    return null
  }
  return mapUserInfo(raw as Record<string, unknown>)
}

function applyProfile(row: Record<string, unknown>) {
  const mapped = mapUserInfo(row)
  userInfo.value = mapped
  saveUserInfo(mapped)
}

function hasToken(): boolean {
  const token = String(uni.getStorageSync(TOKEN_KEY) || '').trim()
  return token != ''
}

function resetGuestState() {
  isLogged.value = false
  userInfo.value = null
  favoriteList.value = []
  loadingFavorites.value = false
  stats.value = {
    published: 0,
    favorites: 0,
    history: 0
  }
}

function updateFavoriteCount() {
  stats.value.favorites = favoriteList.value.length
}

function asBool(value: unknown): boolean {
  return value === true || value === 1 || value === '1'
}

async function fetchProfile() {
  const payload = await request<ProfileResponse>({
    url: '/api/user/profile',
    method: 'GET'
  })
  if (payload.ok !== true || payload.data == null) {
    throw new Error(payload.message || 'profile is empty')
  }
  applyProfile(payload.data)
}

async function fetchFavorites() {
  const payload = await request<FavoriteListResponse>({
    url: '/api/user/favorites',
    method: 'GET'
  })
  if (payload.ok !== true || !Array.isArray(payload.data)) {
    throw new Error(payload.message || 'favorites is empty')
  }
  favoriteList.value = payload.data.map((item) => mapHouseRow(item))
  updateFavoriteCount()
}

function goDetail(id: string) {
  uni.navigateTo({ url: '/pages/sublet/detail?id=' + id })
}

async function onRemoveFavorite(houseId: string, index: number) {
  const id = String(houseId || '').trim()
  if (id == '') {
    return
  }

  if (!hasToken()) {
    uni.showToast({ title: '请先登录', icon: 'none' })
    return
  }

  try {
    const payload = await request<FavoriteToggleResponse>({
      url: '/api/user/favorite/toggle',
      method: 'POST',
      data: {
        house_id: Number.parseInt(id, 10)
      }
    })
    if (payload.ok !== true) {
      uni.showToast({ title: payload.message || '取消收藏失败', icon: 'none' })
      return
    }

    const nextIsFavorited = asBool(payload.data?.isFavorited)
    if (nextIsFavorited) {
      uni.showToast({ title: '取消收藏失败', icon: 'none' })
      return
    }

    if (index >= 0 && index < favoriteList.value.length && favoriteList.value[index]?.id == id) {
      favoriteList.value.splice(index, 1)
    } else {
      favoriteList.value = favoriteList.value.filter((item) => item.id != id)
    }
    updateFavoriteCount()
    uni.$emit(REFRESH_FAVORITES_EVENT)
    uni.showToast({ title: '已取消收藏', icon: 'none' })
  } catch (error) {
    console.error('[user] remove favorite failed:', error)
    uni.showToast({ title: '取消收藏失败，请稍后重试', icon: 'none' })
  }
}

function onLogout() {
  uni.showModal({
    title: '确认退出',
    content: '确定要退出当前账号吗？',
    confirmText: '确定',
    cancelText: '取消',
    success: (res) => {
      if (!res.confirm) {
        return
      }
      uni.clearStorageSync()
      resetGuestState()
      uni.showToast({ title: '已退出', icon: 'none' })
    }
  })
}

function onProfileCardClick() {
  if (!isLogged.value) {
    uni.navigateTo({ url: '/pages/login/login' })
    return
  }
  uni.navigateTo({ url: '/pages/user/edit' })
}

async function refreshUserCenter() {
  isLogged.value = hasToken()
  userInfo.value = readUserInfo()

  if (!isLogged.value) {
    resetGuestState()
    return
  }

  loadingFavorites.value = true
  try {
    await Promise.all([fetchProfile(), fetchFavorites()])
  } catch (error) {
    console.error('[user] load data failed:', error)
    if (userInfo.value == null) {
      uni.showToast({ title: '加载失败，请稍后重试', icon: 'none' })
    }
  } finally {
    loadingFavorites.value = false
  }
}

async function onRefreshFavorites() {
  if (!hasToken()) {
    return
  }
  try {
    await fetchFavorites()
  } catch (error) {
    console.error('[user] refresh favorites failed:', error)
  }
}

async function onRefreshUserProfile() {
  if (!hasToken()) {
    return
  }
  const cached = readUserInfo()
  if (cached != null) {
    userInfo.value = cached
  }
  try {
    await fetchProfile()
  } catch (error) {
    console.error('[user] refresh profile failed:', error)
  }
}

onLoad(async () => {
  uni.$off(REFRESH_FAVORITES_EVENT, onRefreshFavorites)
  uni.$on(REFRESH_FAVORITES_EVENT, onRefreshFavorites)
  uni.$off(REFRESH_USER_PROFILE_EVENT, onRefreshUserProfile)
  uni.$on(REFRESH_USER_PROFILE_EVENT, onRefreshUserProfile)

  if (!hasToken()) {
    resetGuestState()
    return
  }
  await refreshUserCenter()
})

onShow(() => {
  if (!hasToken()) {
    resetGuestState()
    return
  }
  onRefreshUserProfile()
  onRefreshFavorites()
})

onUnload(() => {
  uni.$off(REFRESH_FAVORITES_EVENT, onRefreshFavorites)
  uni.$off(REFRESH_USER_PROFILE_EVENT, onRefreshUserProfile)
})
</script>

<style scoped>
