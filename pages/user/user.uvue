<template>
  <view class="page">
    <scroll-view class="content" direction="vertical">
      <view class="hero">
        <view class="profile-card" :class="{ 'profile-card-guest': userInfo == null }" @click="onProfileCardClick">
          <image v-if="userInfo != null && userInfo.avatar != ''" class="avatar" :src="userInfo.avatar" mode="aspectFill"></image>
          <view v-else class="avatar-fallback">
            <text class="avatar-fallback-icon">👤</text>
          </view>

          <view class="profile-main">
            <text class="nickname">{{ userInfo != null ? userInfo.nickname : '点击登录' }}</text>
            <text v-if="userInfo != null && userInfo.bio != ''" class="bio">{{ userInfo.bio }}</text>
          </view>
        </view>
      </view>

      <view v-if="!isLogged" class="guest-placeholder-wrap">
        <text class="guest-placeholder-text">登录后查看我的游民资产</text>
      </view>

      <view v-else>
        <view class="stats-panel">
          <view class="stat-item">
            <text class="stat-label">我的发布</text>
            <text class="stat-value">2</text>
          </view>
          <view class="stat-item">
            <text class="stat-label">我的收藏</text>
            <text class="stat-value">{{ favoriteList.length }}</text>
          </view>
          <view class="stat-item">
            <text class="stat-label">浏览记录</text>
            <text class="stat-value">18</text>
          </view>
        </view>

        <view class="section-head">
          <text class="section-title">我的收藏</text>
        </view>

        <view v-if="loadingFavorites" class="state-wrap">
          <text class="state-text">正在加载收藏房源...</text>
        </view>

        <view v-else-if="favoriteList.length == 0" class="state-wrap">
          <text class="state-text">你还没有收藏房源，去安家大厅逛逛吧</text>
        </view>

        <view v-else class="card-list">
          <view
            class="house-card"
            v-for="room in favoriteList"
            :key="room.id"
            @click="goDetail(room.id)"
          >
            <view class="card-image-wrap">
              <image class="card-image" :src="coverUrl(room.cover_image)" mode="aspectFill"></image>
              <text class="green-badge">收藏优选</text>
              <text class="price-badge">¥{{ priceText(room.price) }}/月</text>
            </view>

            <view class="card-content">
              <text class="card-title">{{ room.title }}</text>
              <text class="card-location">📍 {{ room.city_name }} · {{ room.district }}</text>
              <view class="tag-row" v-if="splitTags(room.tags).length > 0">
                <text
                  class="tag-chip"
                  v-for="(tag, index) in splitTags(room.tags).slice(0, 3)"
                  :key="room.id + '-' + index"
                >
                  {{ tag }}
                </text>
              </view>
            </view>
          </view>
        </view>

        <view class="logout-btn" @click="onLogout">
          <text class="logout-text">退出登录</text>
        </view>
      </view>

      <view style="height: 24px;"></view>
    </scroll-view>
  </view>
</template>

<script setup lang="ts">
import { ref } from 'vue'

interface ProfileResponse {
  ok: boolean
  data?: Record<string, unknown>
  message?: string
}

interface FavoriteResponse {
  ok: boolean
  data?: Record<string, unknown>[]
  message?: string
}

interface ProfileInfo {
  nickname: string
  bio: string
  avatar: string
}

interface HouseItem {
  id: string
  city_id: string
  city_name: string
  title: string
  cover_image: string
  price: number
  district: string
  tags: string
}

const API_BASE_URL = 'http://localhost:3000'
const LOGIN_FLAG_KEY = 'isLogged'

const isLogged = ref(false)
const userInfo = ref<ProfileInfo | null>(null)
const favoriteList = ref<HouseItem[]>([])
const loadingFavorites = ref(true)
let hasLoaded = false

function parseApiPayload<T>(raw: unknown): T | null {
  if (raw != null && typeof raw == 'object') {
    return raw as T
  }
  if (typeof raw == 'string') {
    const text = raw.trim()
    if (text == '') {
      return null
    }
    try {
      return JSON.parse<T>(text)
    } catch (error) {
      return null
    }
  }
  return null
}

function splitTags(rawTags: string): string[] {
  const text = String(rawTags || '').trim()
  if (text == '') {
    return []
  }
  return text
    .split(/[、,，;；|/]+/)
    .map((item) => item.trim())
    .filter((item) => item != '')
}

function priceText(value: number): string {
  if (!Number.isFinite(value) || value <= 0) {
    return '--'
  }
  return String(Math.round(value))
}

function coverUrl(value: string): string {
  const text = String(value || '').trim()
  if (text != '') {
    return text
  }
  return '/static/images/2.jpg'
}

function mapHouseRow(row: Record<string, unknown>): HouseItem {
  return {
    id: String(row.id ?? ''),
    city_id: String(row.city_id ?? ''),
    city_name: String(row.city_name ?? ''),
    title: String(row.title ?? ''),
    cover_image: String(row.cover_image ?? ''),
    price: Number(row.price ?? 0),
    district: String(row.district ?? ''),
    tags: String(row.tags ?? '')
  }
}

function applyProfile(row: Record<string, unknown>) {
  const nickname = String(row.nickname ?? '').trim()
  const bio = String(row.bio ?? '').trim()
  const avatar = String(row.avatar ?? '').trim()

  userInfo.value = {
    nickname: nickname != '' ? nickname : '数字游民',
    bio: bio != '' ? bio : '今天也在低成本生活',
    avatar
  }
}

async function fetchProfile() {
  return new Promise<void>((resolve, reject) => {
    uni.request({
      url: API_BASE_URL + '/api/user/profile',
      method: 'GET',
      success: (res) => {
        if (res.statusCode != 200) {
          reject('request failed: ' + res.statusCode)
          return
        }
        const payload = parseApiPayload<ProfileResponse>(res.data)
        if (payload == null || payload.ok != true || payload.data == null) {
          reject(payload?.message ?? 'profile is empty')
          return
        }
        applyProfile(payload.data)
        resolve()
      },
      fail: (error) => reject(error)
    })
  })
}

async function fetchFavorites() {
  return new Promise<void>((resolve, reject) => {
    uni.request({
      url: API_BASE_URL + '/api/user/favorites',
      method: 'GET',
      success: (res) => {
        if (res.statusCode != 200) {
          reject('request failed: ' + res.statusCode)
          return
        }
        const payload = parseApiPayload<FavoriteResponse>(res.data)
        if (payload == null || payload.ok != true || !Array.isArray(payload.data)) {
          reject(payload?.message ?? 'favorites is empty')
          return
        }
        favoriteList.value = payload.data.map((item) => mapHouseRow(item))
        resolve()
      },
      fail: (error) => reject(error)
    })
  })
}

function goDetail(id: string) {
  uni.navigateTo({ url: '/pages/sublet/detail?id=' + id })
}

function onLogout() {
  uni.showModal({
    title: '确认退出',
    content: '确定要退出当前账号吗？',
    confirmText: '确定',
    cancelText: '取消',
    success: (res) => {
      if (!res.confirm) {
        return
      }
      uni.removeStorageSync(LOGIN_FLAG_KEY)
      isLogged.value = false
      userInfo.value = null
      favoriteList.value = []
      loadingFavorites.value = false
      uni.showToast({ title: '已退出', icon: 'none' })
    }
  })
}

function onProfileCardClick() {
  if (isLogged.value) {
    return
  }
  uni.navigateTo({ url: '/pages/login/login' })
}

function getIsLogged(): boolean {
  const value = uni.getStorageSync(LOGIN_FLAG_KEY)
  if (value === true || value === 1) {
    return true
  }
  if (typeof value == 'string') {
    const text = value.trim().toLowerCase()
    return text == 'true' || text == '1'
  }
  return false
}

async function refreshUserCenter() {
  isLogged.value = getIsLogged()
  if (!isLogged.value) {
    userInfo.value = null
    favoriteList.value = []
    loadingFavorites.value = false
    return
  }

  loadingFavorites.value = true
  try {
    await Promise.all([fetchProfile(), fetchFavorites()])
  } catch (error) {
    console.error('[user] load data failed:', error)
    userInfo.value = null
    uni.showToast({ title: '加载我的页面失败', icon: 'none' })
  } finally {
    loadingFavorites.value = false
  }
}

onLoad(async () => {
  await refreshUserCenter()
  hasLoaded = true
})

onShow(async () => {
  if (!hasLoaded) {
    return
  }
  await refreshUserCenter()
})
</script>

