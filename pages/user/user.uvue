<template>
  <view class="page">
    <scroll-view class="content" direction="vertical">
      <view v-if="loading" class="state-box">
        <text class="state-text">正在整理你的旅居档案...</text>
      </view>

      <view v-else>
        <view class="identity-card">
          <image class="identity-bg" src="/static/images/3.jpg" mode="aspectFill"></image>
          <view class="identity-mask"></view>
          <view class="identity-main">
            <image class="avatar" :src="avatar" mode="aspectFill"></image>
            <text class="nickname">{{ nickname }}</text>
            <text class="nomad-pill">已在{{ currentCity }}旅居 {{ nomadDays }} 天</text>

            <view class="tag-row">
              <text v-for="tag in displayTags" :key="tag" class="tag-pill">{{ tag }}</text>
            </view>

            <view class="wallet-box">
              <view class="wallet-col">
                <text class="wallet-label">钱包余额</text>
                <text class="wallet-value">¥{{ walletBalanceText }}</text>
              </view>
              <view class="wallet-divider"></view>
              <view class="wallet-col">
                <text class="wallet-label">本月收入</text>
                <text class="wallet-value">¥{{ walletIncomeText }}</text>
              </view>
            </view>
          </view>
        </view>

        <view class="panel">
          <text class="panel-title">旅居仪表盘</text>
          <view class="dashboard-grid">
            <view v-for="card in dashboardCards" :key="card.id" class="metric-card">
              <text class="metric-icon">{{ card.icon }}</text>
              <text class="metric-value">{{ card.value }}</text>
              <text class="metric-label">{{ card.title }}</text>
            </view>
          </view>
        </view>

        <view class="panel">
          <text class="panel-title">功能列表</text>
          <view v-for="item in menuItems" :key="item.id" class="menu-row" @click="onMenuClick(item.id)">
            <view class="menu-left">
              <text class="menu-title">{{ item.title }}</text>
              <text class="menu-desc">{{ item.desc }}</text>
            </view>
            <text class="menu-arrow">›</text>
          </view>

          <view class="logout-btn" hover-class="logout-btn-active" @click="onLogout">
            <text class="logout-text">退出登录</text>
          </view>
        </view>

        <view style="height: 100px;"></view>
      </view>
    </scroll-view>

    <tab-bar active="user" />
  </view>
</template>

<script setup lang="ts">
import { computed, ref } from 'vue'
import TabBar from '../../components/TabBar.uvue'
import type { UserMenuItem } from '../../types/user'

const loading = ref(true)
const API_BASE_URL = 'http://localhost:3000'

const nickname = ref('数字游民')
const avatar = ref('/static/logo.png')
const currentCity = ref('--')
const nomadDays = ref(0)
const displayTags = ref<string[]>(['旅居中'])
const walletBalance = ref(0)
const walletIncome = ref(3200)
const resumeCompletion = ref(85)
const favoriteCities = ref<string[]>(['鹤岗', '伊春'])
const dashboard = ref({
  appliedJobs: 0,
  postedRooms: 0,
  joinedParties: 0
})

interface ApiUserProfile {
  id: number
  username: string
  avatar: string
  tagline: string
  balance: number | string
  created_at: string
}

interface ApiUserProfileResponse {
  ok: boolean
  data?: ApiUserProfile
  message?: string
}

const dashboardCards = computed(() => [
  { id: 'gigs', icon: '💼', title: '搞钱', value: dashboard.value.appliedJobs },
  { id: 'sublet', icon: '🏠', title: '安家', value: dashboard.value.postedRooms },
  { id: 'social', icon: '💜', title: '搭子', value: dashboard.value.joinedParties }
])

const menuItems = computed<UserMenuItem[]>(() => {
  return [
    { id: 'resume', title: '我的简历', desc: `完整度 ${resumeCompletion.value}%` },
    { id: 'favorites', title: '收藏城市', desc: favoriteCities.value.length == 0 ? '暂无收藏' : favoriteCities.value.join(' · ') },
    { id: 'settings', title: '系统设置', desc: '通知、隐私、账号安全' }
  ]
})

function formatCurrency(value: number): string {
  const fixed = value.toFixed(2)
  if (fixed.endsWith('.00')) {
    return fixed.slice(0, fixed.length - 3)
  }
  return fixed
}

const walletBalanceText = computed(() => formatCurrency(walletBalance.value))
const walletIncomeText = computed(() => formatCurrency(walletIncome.value))

const onMenuClick = (id: string) => {
  if (id == 'resume') {
    uni.showToast({ title: '简历模块开发中', icon: 'none' })
  } else if (id == 'favorites') {
    uni.showToast({ title: '收藏城市功能开发中', icon: 'none' })
  } else {
    uni.showToast({ title: '系统设置开发中', icon: 'none' })
  }
}

const onLogout = () => {
  uni.showToast({ title: '已退出登录（模拟）', icon: 'none' })
}

function parseTagline(tagline: string): { city: string; days: number } {
  const text = (tagline ?? '').trim()
  const matched = text.match(/已在(.+?)旅居\s*(\d+)\s*天/)
  if (matched != null) {
    return {
      city: matched[1] ?? '--',
      days: Number(matched[2] ?? '0')
    }
  }
  return { city: '--', days: 0 }
}

function toNumber(value: number | string, fallback: number): number {
  const parsed = typeof value == 'number' ? value : parseFloat(value)
  return isNaN(parsed) ? fallback : parsed
}

function applyUserProfile(profile: ApiUserProfile) {
  nickname.value = profile.username ?? nickname.value
  avatar.value = profile.avatar != '' ? profile.avatar : '/static/logo.png'
  walletBalance.value = toNumber(profile.balance, walletBalance.value)

  const parsed = parseTagline(profile.tagline ?? '')
  currentCity.value = parsed.city
  nomadDays.value = parsed.days
  displayTags.value = [`${currentCity.value}旅居`, '大本营模式']
}

const fetchUserProfile = async () => {
  try {
    await new Promise<void>((resolve, reject) => {
      uni.request({
        url: `${API_BASE_URL}/api/user/profile`,
        method: 'GET',
        success: (res) => {
          if (res.statusCode != 200) {
            reject(`请求失败: ${res.statusCode}`)
            return
          }
          try {
            const str = JSON.stringify(res.data)
            const payload = JSON.parse<ApiUserProfileResponse>(str) as ApiUserProfileResponse | null
            if (payload == null || !payload.ok || payload.data == null) {
              reject(payload?.message ?? '用户信息为空')
              return
            }
            applyUserProfile(payload.data)
            resolve()
          } catch (error) {
            reject(`解析失败: ${error}`)
          }
        },
        fail: (err) => reject(err)
      })
    })
  } catch (error) {
    uni.showToast({ title: '用户数据加载失败', icon: 'none' })
  } finally {
    loading.value = false
  }
}

onLoad(() => {
  fetchUserProfile()
})
</script>

