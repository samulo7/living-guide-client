PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root123
DB_NAME=nomad_guide
JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=7d
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=7
BACKUP_GZIP=false
# Optional. Set to full path when mysqldump is not in PATH on Windows.
MYSQLDUMP_PATH=

OSS_REGION=oss-cn-hangzhou
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_BUCKET=your-bucket-name
# Optional, only needed for custom endpoint/private networking.
OSS_ENDPOINT=
# Optional, if empty defaults to https://{bucket}.{endpoint}
OSS_PUBLIC_BASE_URL=

# Gaode (Amap) WebService key for reverse geocoding
AMAP_WEB_KEY=
# Optional, default is https://restapi.amap.com
AMAP_SERVICE_HOST=

