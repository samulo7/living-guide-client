export interface RadarData {
  cost: number
  medical: number
  transport: number
  climate: number
  fun: number
}

export interface CityDetail {
  guru_comment: string
  climate_info: string
  cons: string
  medical_desc: string
  transport_desc: string
}

export interface CityLocation {
  lat: number
  lng: number
}

export interface CityItem {
  id: string
  city: string
  district: string
  title: string
  name?: string
  location_text?: string
  medical: string
  transport: string
  landscape?: string
  suitable_crowd?: string
  editor_comment?: string
  cover_image: string
  is_verified: boolean
  has_hospital_class_a: boolean
  price_rent: number
  price_buy: string
  tags: string[]
  detail: CityDetail
  radar_data: RadarData
  location: CityLocation
}

export interface CityMeta {
  generated_at: string
  source: string
}

export interface CityData {
  version: number
  update_date: string
  total: number
  items: CityItem[]
  meta?: CityMeta
}
